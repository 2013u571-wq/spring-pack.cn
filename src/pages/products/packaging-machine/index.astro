---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const productName = '自动装箱机与纸箱包装机';
const productUrl = 'https://spring-pack.cn/products/packaging-machine/';
const assetBase = '/assets/first-machinery/products/packaging-machine/automatic-case-packer';

const gallery = [
  { src: `${assetBase}/automatic-case-packer-factory.webp`, alt: '自动装箱机工厂实拍', label: '自动装箱机' },
  { src: `${assetBase}/case-packing-conveyor-system.webp`, alt: '纸箱包装机和输送系统', label: '包装系统' },
  { src: `${assetBase}/automatic-case-packer-detail.webp`, alt: '自动装箱机设备细节', label: '设备细节' },
  { src: `${assetBase}/automatic-case-packing-line.webp`, alt: '自动纸箱包装生产线', label: '包装产线' },
  { src: `${assetBase}/case-packer-conveyor-detail.webp`, alt: '纸箱包装机输送细节', label: '输送细节' },
  { src: `${assetBase}/end-of-line-case-packing-equipment.webp`, alt: '后段纸箱包装设备', label: '后段包装设备' },
];

const specRows = [
  ['产品类型', '自动装箱机 / 纸箱包装机'],
  ['应用范围', '瓶装水、果汁、茶饮、碳酸饮料以及其他已包装产品'],
  ['包装形式', '纸箱包装；装箱排列方式和纸箱尺寸按项目需求配置'],
  ['自动化功能', '自动产品排列、纸箱成型、推入装箱、折盖和封口'],
  ['产线连接', '可连接贴标、膜包、纸箱封口、喷码、输送和码垛设备'],
  ['控制系统', 'PLC控制，配备安全保护和人机触摸屏操作界面'],
  ['设备材质', '按项目要求配置工业不锈钢和碳钢结构'],
  ['电源配置', '按当地工厂电压和电气标准配置'],
];

const capabilities = [
  ['产品排列', '产品在装箱前自动汇集、对齐，并按设定排列方式分组。'],
  ['纸箱包装', '设备可将成品稳定、精准地推入成型纸箱，适合后段连续包装。'],
  ['灵活配置', '瓶径、瓶高、纸箱尺寸、排列层数和目标产能都会在设计前确认。'],
  ['产线集成', '系统可配套进料输送、纸箱成型、封箱、喷码和码垛连接。'],
];

const workflow = [
  ['01', '产品进料', '成品从贴标、检测或前段输送进入装箱区域。'],
  ['02', '自动排列', '装箱机按设定纸箱规格排列产品。'],
  ['03', '推入装箱', '分组后的产品自动推入已成型纸箱。'],
  ['04', '纸箱输出', '完成装箱后的纸箱继续进入封箱、喷码、码垛或出货工序。'],
];

const faqs = [
  ['这款装箱机适合哪些产品？', '可根据瓶装水、果汁、茶饮、碳酸饮料以及其他成品包装项目配置。报价前建议提供产品尺寸、外形、目标排列方式和纸箱规格。'],
  ['可以连接现有生产线吗？', '可以。包装系统可与现有贴标机、膜包机、封箱机、喷码机、输送线或码垛工位配套连接。'],
  ['可以使用哪些纸箱规格？', '纸箱尺寸和产品排列方式会围绕项目需求设计。建议提供纸箱图纸或每箱产品数量及排列要求。'],
  ['报价前需要提供哪些资料？', '请提供产品照片或图纸、产品尺寸、目标产能、每分钟纸箱数量、纸箱尺寸、装箱排列方式、工厂电压和可用场地。'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description: '自动装箱机与纸箱包装机适用于食品、饮料、日化、医药等行业产品自动箱装，可按纸箱尺寸、排列方式和目标产能配置。',
  image: gallery.map((item) => new URL(item.src, 'https://spring-pack.cn').toString()),
  brand: { '@type': 'Brand', name: 'First Machinery' },
  manufacturer: { '@type': 'Organization', name: '中科美利（苏州）包装设备有限公司' },
  category: '包装机',
  url: productUrl,
};
---

<BaseLayout title={`${productName} | 中科美利（苏州）包装设备有限公司`} description="自动装箱机与纸箱包装机适用于食品、饮料、日化、医药等行业产品自动箱装。">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="pm-hero">
    <div class="pm-hero__image"></div><div class="pm-hero__shade"></div>
    <div class="pm-hero__inner">
      <div class="pm-breadcrumb"><a href="/">首页</a><span>/</span><a href="/products/">产品中心</a><span>/</span><span>包装机</span></div>
      <h1>自动装箱机<br />与纸箱包装机</h1>
      <p>适用于食品、饮料、日化、医药等行业的后段自动装箱，设备可按产品规格、纸箱尺寸、装箱排列方式和目标产能配置。</p>
      <a class="pm-primary-button" href="/contact/?source=product-category&sourceTitle=包装机">获取系统方案</a>
    </div>
  </section>

  <article class="pm-page" id="capacity">
    <section class="pm-product-hero">
      <div class="container pm-product-hero__grid">
        <div class="pm-gallery" data-pm-gallery>
          <div class="pm-gallery__main"><img src={gallery[0].src} alt={gallery[0].alt} width="1200" height="900" loading="eager" decoding="async" data-pm-main /><button type="button" data-pm-prev aria-label="上一张产品图片">←</button><button type="button" data-pm-next aria-label="下一张产品图片">→</button></div>
          <div class="pm-gallery__thumbs" aria-label="产品图片">
            {gallery.map((item, index) => <button class:list={['pm-gallery__thumb', index === 0 && 'is-active']} type="button" data-pm-thumb data-src={item.src} data-alt={item.alt} aria-label={`显示 ${item.label}`}><img src={item.src} alt={`${item.alt} 缩略图`} width="120" height="90" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" /></button>)}
          </div>
        </div>
        <div class="product-hero-form-card" id="quote">
          <div class="product-hero-intro-card">
            <p class="product-hero-intro-eyebrow">产品简介</p>
            <h2>自动装箱机与纸箱包装机</h2>
            <p>采用一体式纸箱坯料供料设计，无需预制纸箱，即可自动完成纸箱吸料、展开和精确定型。该机可自动排列产品，将物料平稳地推入成型纸箱，并完成纸箱上下盖的自动折叠和封口。配备变频调速和人机触摸屏操作，参数设置简单，运行稳定，故障率低。支持快速切换不同产品规格和纸箱尺寸，适用于食品、饮料、日化、医药等行业瓶装、罐装、盒装、袋装产品的自动箱装。</p>
            <a class="product-hero-phone-button" href="tel:18962223666" aria-label="拨打电话 18962223666">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
              </svg>
              电话咨询：18962223666
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pm-summary"><div class="container pm-summary__grid"><div><p class="pm-kicker">企业实力</p><h2>20余年行业经验，提供可靠的整线解决方案</h2></div><div class="pm-summary__cards"><div><strong>20+</strong><span>年行业经验<small>丰富的设备制造与项目实施经验</small></span></div><div><strong>整线</strong><span>交钥匙方案<small>从方案设计到安装调试一站式服务</small></span></div><div><strong>CE / ISO</strong><span>国际认证<small>严格质量管理，符合国际标准</small></span></div><div><strong>50+</strong><span>国家和地区<small>设备远销全球，提供完善售后支持</small></span></div></div></div></section>

    <section class="pm-section"><div class="container"><p class="pm-kicker">技术规格</p><h2>自动装箱机参数</h2><div class="pm-spec-table"><table><tbody>{specRows.map(([label, value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></div></div></section>

    <section class="pm-section pm-section--soft"><div class="container"><div class="pm-section-head"><div><p class="pm-kicker">设备细节</p><h2>围绕最终装箱规格进行配置</h2></div><p>系统会作为实用的后段包装模块进行报价，产品规格、纸箱尺寸、排列方式、产线速度和后续输送都会一起评估。</p></div><div class="pm-detail-layout"><figure><img src={gallery[3].src} alt={gallery[3].alt} width="1200" height="675" loading="lazy" decoding="async" /></figure><div class="pm-capability-list">{capabilities.map(([title, text], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></div></section>

    <section class="pm-section"><div class="container"><p class="pm-kicker">包装生产流程</p><h2>纸箱包装系统如何连接产线</h2><div class="pm-flow">{workflow.map(([number, title, text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

    <section class="pm-section pm-section--dark"><div class="container pm-solution"><div><p class="pm-kicker">后段包装方案</p><h2>从成品到可发运纸箱</h2><p>自动装箱机可与贴标、膜包、封箱、日期喷码、输送和码垛设备组合使用。方案既可覆盖单台装箱机，也可覆盖完整后段包装系统。</p><a class="pm-primary-button" href="tel:18962223666">电话咨询：18962223666</a></div><figure><img src={gallery[4].src} alt={gallery[4].alt} width="1200" height="900" loading="lazy" decoding="async" /></figure></div></section>

    <section class="pm-section"><div class="container pm-faq"><div><p class="pm-kicker">常见问题</p><h2>纸箱包装项目常见问题</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

  </article>

  <style>
    .pm-hero{position:relative;display:flex;align-items:center;min-height:500px;overflow:hidden;background:#07110c}.pm-hero__image,.pm-hero__shade{position:absolute;inset:0}.pm-hero__image{background:url('/assets/first-machinery/2026/05/packing-machine-clean.webp') center right/cover no-repeat}.pm-hero__shade{background:linear-gradient(90deg,rgba(2,12,7,.92),rgba(2,12,7,.76) 40%,rgba(2,12,7,.2))}.pm-hero__inner{position:relative;width:min(1250px,100%);margin:auto;padding:88px 42px;color:#fff}.pm-breadcrumb{display:flex;gap:9px;margin-bottom:22px;color:#75cf8e;font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.pm-breadcrumb a{color:inherit;text-decoration:none}.pm-hero h1{max-width:820px;margin:0 0 23px;font-size:clamp(38px,5vw,62px);line-height:1.08;letter-spacing:-.04em}.pm-hero p{max-width:640px;margin:0 0 34px;color:rgba(255,255,255,.75);font-size:17px;line-height:1.55}.pm-primary-button{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 26px;border:1px solid #176b36;border-radius:5px;background:#176b36;color:#fff!important;font-size:14px;font-weight:800;text-decoration:none;transition:.2s}.pm-primary-button:hover{background:#218547;transform:translateY(-2px)}.pm-page{width:100%;min-width:0;overflow:hidden;color:#18201b}.pm-product-hero{padding:58px 0}.pm-product-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,460px);gap:24px;align-items:start}.pm-gallery,.product-hero-form-card{min-width:0}.pm-gallery__main{position:relative;overflow:hidden;background:#edf0ed;aspect-ratio:4/3}.pm-gallery__main>img{width:100%;height:100%;object-fit:cover}.pm-gallery__main>button{position:absolute;top:50%;display:grid;width:43px;height:43px;place-items:center;border:0;background:rgba(16,37,23,.85);color:#fff;font-size:24px;cursor:pointer;transform:translateY(-50%)}.pm-gallery__main [data-pm-prev]{left:14px}.pm-gallery__main [data-pm-next]{right:14px}.pm-gallery__thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;overflow-y:hidden}.pm-gallery__thumb{flex:0 0 88px;padding:0;border:2px solid transparent;background:#edf0ed;cursor:pointer}.pm-gallery__thumb.is-active{border-color:#176b36}.pm-gallery__thumb img{display:block;width:100%;height:68px;object-fit:cover}.pm-kicker{margin:0 0 11px;color:#35623e;font:800 12px/1.2 "IBM Plex Mono",monospace;letter-spacing:.14em;text-transform:uppercase}.pm-section h2{margin:0 0 17px;font-size:clamp(27px,3.2vw,40px);line-height:1.12;letter-spacing:-.03em}.pm-section p{color:#606a63;font-size:16px;line-height:1.65}.pm-summary{padding:45px 0;background:#15241a;color:#fff}.pm-summary__grid{display:grid;grid-template-columns:.8fr 1.5fr;gap:40px;align-items:center}.pm-summary h2{margin:0;font-size:28px;line-height:1.18}.pm-summary .pm-kicker{color:#8ad3a0}.pm-summary__cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.14)}.pm-summary__cards>div{min-height:100px;padding:18px;background:#15241a}.pm-summary__cards strong,.pm-summary__cards span,.pm-summary__cards small{display:block}.pm-summary__cards strong{margin-bottom:8px;color:#8ad3a0;font-size:20px}.pm-summary__cards span{color:rgba(255,255,255,.76);font-size:12px;font-weight:650;line-height:1.35}.pm-summary__cards small{margin-top:4px;color:rgba(255,255,255,.58);font-size:10px;font-weight:500;line-height:1.4}.pm-section{padding:80px 0}.pm-section--soft{background:#f3f5f3}.pm-section--dark{background:#0c1710;color:#fff}.pm-section--dark .pm-kicker{color:#8ad3a0}.pm-section--dark p{color:rgba(255,255,255,.72)}.pm-spec-table{overflow:auto;margin-top:28px;border:1px solid #dde5dd}.pm-spec-table table{width:100%;border-collapse:collapse;font-size:15px}.pm-spec-table th,.pm-spec-table td{padding:17px 20px;border-bottom:1px solid #dde5dd;text-align:left;vertical-align:top}.pm-spec-table th{width:31%;background:#f5f8f5;color:#203226}.pm-spec-table tr:last-child>*{border-bottom:0}.pm-section-head{display:flex;justify-content:space-between;gap:50px;align-items:end;margin-bottom:34px}.pm-section-head>div{max-width:600px}.pm-section-head>p{max-width:430px;margin:0}.pm-detail-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:38px;align-items:stretch}.pm-detail-layout figure,.pm-solution figure{margin:0;background:#dfe6df}.pm-detail-layout figure img,.pm-solution figure img{display:block;width:100%;height:100%;object-fit:cover}.pm-capability-list{display:grid;gap:1px;background:#dce4dc}.pm-capability-list article{display:flex;gap:20px;padding:24px;background:#fff}.pm-capability-list span{color:#35623e;font:800 13px/1 "IBM Plex Mono",monospace}.pm-capability-list h3{margin:0 0 7px;font-size:18px}.pm-capability-list p{margin:0;font-size:14px!important}.pm-flow{display:grid;grid-template-columns:repeat(4,1fr);margin-top:31px;border:1px solid #dce4dc}.pm-flow article{position:relative;padding:29px 25px;border-right:1px solid #dce4dc}.pm-flow article:last-child{border:0}.pm-flow span{display:block;margin-bottom:17px;color:#35623e;font:800 13px/1 "IBM Plex Mono",monospace}.pm-flow h3{margin:0 0 8px;font-size:19px}.pm-flow p{margin:0;font-size:14px!important}.pm-solution{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}.pm-solution h2{font-size:clamp(30px,4vw,48px)}.pm-solution .pm-primary-button{margin-top:13px}.pm-solution figure{min-height:390px}.pm-faq{display:grid;grid-template-columns:.85fr 1.15fr;gap:55px}.pm-faq details{border-top:1px solid #dce4dc}.pm-faq details:last-child{border-bottom:1px solid #dce4dc}.pm-faq summary{padding:20px 34px 20px 0;cursor:pointer;font-size:17px;font-weight:800;list-style:none}.pm-faq summary:after{content:'+';float:right;color:#35623e;font-size:25px;font-weight:400}.pm-faq details[open] summary:after{content:'−'}.pm-faq details p{margin:0;padding:0 28px 22px 0;font-size:14px}.pm-inquiry{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:start}.pm-inquiry>div>p:not(.pm-kicker){max-width:510px}.pm-inquiry ul{display:grid;gap:10px;margin:25px 0 0;padding:0;list-style:none;color:#36503c;font-weight:700}.pm-inquiry li:before{content:'✓';margin-right:10px;color:#176b36}@media(max-width:900px){.pm-product-hero__grid,.pm-detail-layout,.pm-solution,.pm-inquiry,.pm-faq,.pm-summary__grid{grid-template-columns:1fr}.pm-summary__cards{grid-template-columns:repeat(2,1fr)}.pm-section-head{display:block}.pm-section-head>p{margin-top:15px}.pm-flow{grid-template-columns:repeat(2,1fr)}.pm-flow article:nth-child(2){border-right:0}.pm-flow article:nth-child(n+3){border-top:1px solid #dce4dc}}@media(max-width:600px){.pm-page,.pm-product-hero,.pm-summary,.pm-section{width:100%;max-width:none}.pm-hero{min-height:390px;align-items:end}.pm-hero__inner{padding:40px 20px}.pm-hero h1{font-size:34px}.pm-hero p{font-size:14px;margin-bottom:23px}.pm-product-hero,.pm-section{padding:44px 0}.product-hero-form{padding:22px 18px}.product-hero-form label,.product-hero-form label.product-hero-form-message{grid-template-columns:1fr;gap:7px;min-height:0}.product-hero-form em.is-visible{grid-column:auto}.product-hero-form-message>span{padding-top:0}.product-hero-phone-control{grid-template-columns:minmax(96px,.36fr) minmax(0,1fr)}.product-hero-form-message textarea{min-height:120px}.pm-summary{padding:40px 0}.pm-summary__cards{grid-template-columns:1fr 1fr}.pm-summary__cards>div{min-height:86px;padding:14px}.pm-flow{grid-template-columns:1fr}.pm-flow article{border-right:0!important;border-bottom:1px solid #dce4dc}.pm-flow article:last-child{border-bottom:0}.pm-gallery__thumb{flex-basis:74px}.pm-gallery__thumb img{height:58px}}
  </style>

  <script is:inline>
    document.querySelectorAll('[data-pm-gallery]').forEach((gallery) => {
      const main = gallery.querySelector('[data-pm-main]');
      const thumbs = Array.from(gallery.querySelectorAll('[data-pm-thumb]'));
      let current = 0;
      const show = (index) => {
        current = (index + thumbs.length) % thumbs.length;
        const button = thumbs[current];
        main.src = button.dataset.src;
        main.alt = button.dataset.alt;
        thumbs.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === current));
      };
      thumbs.forEach((button, index) => button.addEventListener('click', () => show(index)));
      gallery.querySelector('[data-pm-prev]')?.addEventListener('click', () => show(current - 1));
      gallery.querySelector('[data-pm-next]')?.addEventListener('click', () => show(current + 1));
    });
  </script>
</BaseLayout>
