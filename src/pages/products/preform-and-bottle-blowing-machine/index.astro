  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description: '全自动PET塑料吹瓶机适用于PET瓶高速生产，可完成自动送料、加热、拉伸、吹塑成型和成品输出。',
