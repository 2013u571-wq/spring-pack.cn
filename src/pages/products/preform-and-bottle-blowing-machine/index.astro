    title: '瓶子成型',
    image: `${assetBase}/bottle-forming.webp`,
    alt: '全自动拉伸吹塑单元中的PET瓶成型',
  },
];

const faqs = [
  {
    question: '这款吹瓶机可以生产哪些瓶型？',
