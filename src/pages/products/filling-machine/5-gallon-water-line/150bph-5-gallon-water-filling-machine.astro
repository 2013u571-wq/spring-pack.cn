  <script is:inline>
    (() => {
      document.querySelectorAll('[data-product-gallery]').forEach((gallery) => {
        const mainImage = gallery.querySelector('[data-gallery-main]');
        const thumbs = Array.from(gallery.querySelectorAll('[data-gallery-thumb]'));
        const previous = gallery.querySelector('[data-gallery-prev]');
        const next = gallery.querySelector('[data-gallery-next]');
        let activeIndex = 0;

        const setActive = (nextIndex) => {
          if (!mainImage || thumbs.length === 0) return;
          activeIndex = (nextIndex + thumbs.length) % thumbs.length;
          const activeThumb = thumbs[activeIndex];
          const imageSrc = activeThumb.getAttribute('data-gallery-src');
          const imageAlt = activeThumb.getAttribute('data-gallery-alt') || '';

          if (imageSrc) mainImage.setAttribute('src', imageSrc);
          mainImage.setAttribute('alt', imageAlt);

          thumbs.forEach((thumb, index) => {
            const isActive = index === activeIndex;
            thumb.classList.toggle('is-active', isActive);
            thumb.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
        };

        thumbs.forEach((thumb, index) => {
          thumb.addEventListener('click', () => setActive(index));
          thumb.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
              event.preventDefault();
              setActive(index + 1);
              thumbs[(index + 1) % thumbs.length]?.focus();
            }
            if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
              event.preventDefault();
              setActive(index - 1);
              thumbs[(index - 1 + thumbs.length) % thumbs.length]?.focus();
            }
          });
        });

        previous?.addEventListener('click', () => setActive(activeIndex - 1));
        next?.addEventListener('click', () => setActive(activeIndex + 1));
      });

      const stickyCta = document.querySelector('[data-sticky-cta]');
      if (stickyCta) {
        const stickyReveal滚动Y = 500;
        const setStickyVisible = (visible) => {
          stickyCta.classList.toggle('is-visible', visible);
        };
        const updateSticky = () => {
          setStickyVisible(window.scrollY >= stickyReveal滚动Y);
        };
        updateSticky();
        window.addEventListener('scroll', updateSticky, { passive: true });
      }

      const quoteModal = document.querySelector('[data-mobile-quote-modal]');
      const quoteTrigger = document.querySelector('[data-mobile-quote-trigger]');
      const isMobileQuote = () => window.matchMedia('(max-width: 921px)').matches;
      const openQuoteModal = () => {
        if (!quoteModal) return;
        quoteModal.hidden = false;
        document.body.classList.add('mobile-quote-open');
        requestAnimationFrame(() => {
          quoteModal.classList.add('is-open');
          quoteModal.querySelector('input[name="name"]')?.focus();
        });
      };
      const closeQuoteModal = () => {
        if (!quoteModal) return;
        quoteModal.classList.remove('is-open');
        document.body.classList.remove('mobile-quote-open');
        window.setTimeout(() => {
          if (!quoteModal.classList.contains('is-open')) quoteModal.hidden = true;
        }, 180);
      };

      quoteTrigger?.addEventListener('click', (event) => {
        if (!isMobileQuote()) return;
        event.preventDefault();
        openQuoteModal();
      });

      quoteModal?.querySelectorAll('[data-mobile-quote-close]').forEach((item) => {
        item.addEventListener('click', closeQuoteModal);
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && quoteModal?.classList.contains('is-open')) {
          closeQuoteModal();
        }
      });
    })();
  </script>
