---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const heroBackground = '/assets/first-machinery/2026/05/5gallon-filling-machine.webp';

const products = [
  {
    name: '150BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/150bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/150bph-5-gallon-water-filling-machine/150bph-5-gallon-water-filling-machine-main.webp',
    alt: '150BPH 5加仑桶装水灌装机',
  },
  {
    name: '300BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/300bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/300bph-5-gallon-water-filling-machine/300bph-5-gallon-water-filling-machine-main.webp',
    alt: '300BPH桶装饮用水灌装机',
  },
  {
    name: '450BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/450bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/450bph-5-gallon-water-filling-machine/450bph-5-gallon-water-filling-machine-main.webp',
    alt: '450BPH 5加仑桶装水清洗灌装封盖系统',
  },
  {
    name: '600BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/600bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/600bph-5-gallon-water-filling-machine/600bph-5-gallon-water-filling-machine-main.webp',
    alt: '600BPH自动桶装水生产线灌装机',
  },
  {
    name: '900BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/900bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/900bph-5-gallon-water-filling-machine/900bph-5-gallon-water-filling-machine-main.webp',
    alt: '900BPH高产能桶装水灌装机',
  },
  {
    name: '1200BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/1200bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/1200bph-5-gallon-water-filling-machine/1200bph-5-gallon-water-filling-machine-main.webp',
    alt: '1200BPH桶装饮用水灌装机',
  },
  {
    name: '1500BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/1500bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/1500bph-5-gallon-water-filling-machine/1500bph-5-gallon-water-filling-machine-main.webp',
    alt: '1500BPH自动桶装水生产线设备',
  },
  {
    name: '2000BPH 5加仑桶装水灌装机',
    href: '/products/filling-machine/5-gallon-water-line/2000bph-5-gallon-water-filling-machine/',
    image:
      '/assets/first-machinery/products/5-gallon-water-line/2000bph-5-gallon-water-filling-machine/2000bph-5-gallon-water-filling-machine-main.webp',
    alt: '2000BPH大型桶装水生产线灌装机',
  },
];

const flowSteps = [
  {
    number: '01',
    title: '水处理系统',
    text: '通过过滤、反渗透和杀菌处理原水。',
    image: '/assets/first-machinery/products/5-gallon-water-line/production-line-flow/water-treatment-system.webp',
  },
  {
    number: '02',
    title: '自动拔盖',
    text: '去除回收桶上的旧桶盖，为后续清洗做好准备。',
    image: '/assets/first-machinery/products/5-gallon-water-line/production-line-flow/02-decapper.webp',
  },
  {
    number: '03',
    title: '桶内刷洗',
    text: '刷洗桶内壁，清除回收桶内的残留物。',
    image: '/assets/first-machinery/products/5-gallon-water-line/production-line-flow/03-internal-bottle-brushing.webp',
  },
  {
    number: '04',
    title: '桶内消毒',
    text: '使用消毒液清洗并消毒桶内表面。',
    image: '/assets/first-machinery/products/5-gallon-water-line/production-line-flow/04-internal-sterilization.webp',
  },
  {
    number: '05',
    title: '5加仑桶装水灌装',
    text: '将净化后的饮用水灌入清洗完成的5加仑桶。',
    image: '/assets/first-machinery/products/5-gallon-water-line/production-line-flow/05-5-gallon-bottle-filling.webp',
  },
  {
    number: '06',
    title: '成品桶码垛',
    text: '对灌装后的成品桶进行码垛，便于搬运和运输。',
    image: '/assets/first-machinery/products/5-gallon-water-line/production-line-flow/06-5-gallon-bottle-palletizer.webp',
  },
];
---

<BaseLayout
  title="5加仑桶装水灌装线 | 桶装水生产线"
  description="5加仑桶装水灌装线分类页，覆盖150BPH至2000BPH桶装饮用水项目，支持整线规划、型号对比和方案报价。"
>
  <article class="water-category-page five-gallon-category-page">
    <section class="water-category-hero" style={`--water-hero-bg: url(${heroBackground})`}>
      <div class="container">
        <nav class="water-category-breadcrumb" aria-label="面包屑导航">
          <a href="/" aria-label="首页">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 10.5 12 3l9 7.5"></path>
              <path d="M5.5 9.5V20h13V9.5"></path>
              <path d="M9.5 20v-6h5v6"></path>
            </svg>
            首页
          </a>
          <svg class="breadcrumb-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
          <a href="/products/">产品中心</a>
          <svg class="breadcrumb-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
          <a href="/products/filling-machine/">灌装机</a>
          <svg class="breadcrumb-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
          <span>5加仑桶装水生产线</span>
        </nav>

        <div class="water-category-hero-content">
          <p class="water-category-hero-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3C9 7.5 6 10.9 6 14.2A6 6 0 0 0 18 14.2C18 10.9 15 7.5 12 3z"></path>
            </svg>
            完整5加仑桶装水解决方案
          </p>
          <h1>5加仑桶装水灌装线</h1>
          <p class="water-category-hero-subtitle">
            适用于3-5加仑、19-20L桶装饮用水生产线的自动灌装解决方案。
          </p>

          <div class="water-category-hero-features" aria-label="5加仑桶装水灌装线亮点">
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 20V9"></path>
                <path d="M20 20V5"></path>
                <path d="M8 20V13"></path>
                <path d="M16 20V9"></path>
                <path d="M3 20h18"></path>
                <path d="M9 13h6"></path>
                <path d="M7 9h10"></path>
              </svg>
              <div>
                <strong>150-2000BPH</strong>
                <span>产能范围</span>
              </div>
            </article>
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 3h6"></path>
                <path d="M10 3v4l-2 2v11h8V9l-2-2V3"></path>
                <path d="M8 13h8"></path>
                <path d="M8 17h8"></path>
              </svg>
              <div>
                <strong>3-5加仑</strong>
                <span>瓶型规格</span>
              </div>
            </article>
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 3v3"></path>
                <path d="M12 18v3"></path>
                <path d="M3 12h3"></path>
                <path d="M18 12h3"></path>
                <path d="m5 5 2.2 2.2"></path>
                <path d="m16.8 16.8 2.2 2.2"></path>
                <path d="m19 5-2.2 2.2"></path>
                <path d="m7.2 16.8-2.2 2.2"></path>
              </svg>
              <div>
                <strong>清洗灌装</strong>
                <span>整线集成</span>
              </div>
            </article>
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"></path>
                <path d="m8.5 12 2.2 2.2 4.8-5"></path>
              </svg>
              <div>
                <strong>CE / ISO</strong>
                <span>认证品质</span>
              </div>
            </article>
          </div>

          <div class="water-category-hero-actions">
            <a class="water-category-primary-action" href="/contact/">
              获取方案
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="water-category-products" id="capacity">
      <div class="container">
        <div class="water-category-section-head">
          <span>先选择目标产能范围，再提交桶型、盖型、水源、目标产量和产线范围等项目需求。</span>
        </div>

        <div class="water-product-grid">
          {products.map((product) => (
            <article class="water-product-card">
              <a class="water-product-link" href={product.href}>
                <figure>
                  <img src={product.image} alt={product.alt} width="960" height="960" loading="lazy" decoding="async" />
                </figure>
                <div class="water-product-body">
                  <h3>{product.name}</h3>
                </div>
              </a>
              <a class="water-product-quote" href={product.href}>
                获取报价
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="water-category-flow">
      <div class="container">
        <div class="water-category-section-head">
          <p>完整生产流程</p>
          <h2>典型5加仑桶装水生产线范围</h2>
          <span>5加仑桶装水生产线可按整线报价，也可将水处理、拔盖、内刷、消毒、灌装和码垛等模块分项配置。</span>
        </div>
        <div class="water-flow-grid">
          {flowSteps.map((step) => (
            <article>
              <img src={step.image} alt={`${step.title}设备`} loading="lazy" decoding="async" />
              <div class="water-flow-card-body">
                <div class="water-flow-card-heading">
                  <span>{step.number}</span>
                  <h3>{step.title}</h3>
                </div>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="water-category-guide">
      <div class="container water-guide-grid">
        <div>
          <p class="water-category-kicker">选型说明</p>
          <h2>如何选择5加仑桶装水灌装线</h2>
        </div>
        <div class="water-guide-cards">
          <article>
            <h3>目标产能</h3>
            <p>确认每小时目标桶数、班次计划和日配送目标，便于匹配合适机型。</p>
          </article>
          <article>
            <h3>桶况要求</h3>
            <p>回收桶、新桶和桶身洁净程度会影响拔盖和清洗段配置。</p>
          </article>
          <article>
            <h3>瓶型规格</h3>
            <p>确认3加仑、5加仑、18.9L或20L规格，以及桶口尺寸和盖型。</p>
          </article>
          <article>
            <h3>产线范围</h3>
            <p>确认只需要灌装设备，还是需要从水处理到包装的完整生产线。</p>
          </article>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .water-category-page {
    background: #f6f8f4;
  }

  .water-category-hero {
    position: relative;
    overflow: hidden;
    min-height: 450px;
    padding: 0;
    background-color: #fff;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.92) 34%, rgba(255, 255, 255, 0.58) 57%, rgba(255, 255, 255, 0.08) 82%),
      var(--water-hero-bg);
    background-position: center, center right;
    background-size: cover, cover;
    background-repeat: no-repeat;
  }

  .water-category-hero > .container {
    display: grid;
    min-height: 450px;
    align-content: start;
    padding-top: 26px;
    padding-bottom: 32px;
  }

  .water-category-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 0;
    color: #7c8580;
    font-size: 13px;
    font-weight: 700;
  }

  .water-category-breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #727c76;
  }

  .water-category-breadcrumb span {
    color: #4e8a5a;
  }

  .water-category-breadcrumb svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .water-category-breadcrumb .breadcrumb-chevron {
    width: 12px;
    height: 12px;
    color: #9aa39e;
  }

  .water-category-hero-content {
    display: grid;
    gap: 14px;
    width: min(880px, 58vw);
    margin-top: 38px;
  }

  .water-category-hero-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 16px;
    border: 1px solid rgba(77, 139, 90, 0.16);
    border-radius: 999px;
    background: rgba(226, 244, 231, 0.82);
    color: #4f8c5b;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .water-category-hero-badge svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.1;
  }

  .water-category-hero-content h1 {
    margin: 6px 0 0;
    color: #0d1915;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(46px, 3.7vw, 64px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .water-category-hero-subtitle {
    max-width: 500px;
    margin: 0;
    color: #626f69;
    font-size: clamp(16px, 1.18vw, 21px);
    font-weight: 400;
    line-height: 1.25;
  }

  .water-category-hero-features {
    display: grid;
    grid-template-columns: repeat(4, 180px);
    gap: 12px;
    margin-top: 0;
    width: fit-content;
    max-width: 100%;
  }

  .water-category-hero-features article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 50px;
    padding: 8px 12px;
    border: 1px solid rgba(53, 85, 61, 0.14);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 10px 26px rgba(8, 20, 16, 0.04);
    backdrop-filter: blur(12px) saturate(1.18);
    -webkit-backdrop-filter: blur(12px) saturate(1.18);
  }

  .water-category-hero-features article > svg {
    width: 19px;
    height: 19px;
    color: #416f49;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .water-category-hero-features strong,
  .water-category-hero-features span {
    display: block;
  }

  .water-category-hero-features strong {
    color: #26302b;
    font-size: 11px;
    font-weight: 900;
    line-height: 1.15;
  }

  .water-category-hero-features span {
    margin-top: 2px;
    color: #6d7772;
    font-size: 9px;
    font-weight: 700;
    line-height: 1.2;
  }

  .water-category-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  .water-category-primary-action {
    display: inline-flex;
    min-width: 180px;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border-radius: 10px;
    background: linear-gradient(135deg, #3f7b4d, #5da56d);
    color: #fff;
    box-shadow: 0 14px 34px rgba(50, 106, 62, 0.24);
    font-size: 13px;
    font-weight: 900;
    line-height: 1;
  }

  .water-category-primary-action svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .water-category-kicker,
  .water-category-section-head p {
    margin: 0;
    color: #395d3d;
    font: 800 12px/1 "IBM Plex Mono", monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .water-category-intro,
  .water-category-products,
  .water-category-flow,
  .water-category-guide {
    padding: clamp(50px, 7vw, 86px) 0;
  }

  .water-category-intro {
    padding-bottom: 32px;
  }

  .water-category-products {
    padding-top: clamp(44px, 5vw, 72px);
  }

  .water-category-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(380px, 0.72fr);
    gap: 28px;
    align-items: stretch;
  }

  .water-category-media {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 18px;
    height: 100%;
    background: #fff;
    border: 1px solid rgba(57, 93, 61, 0.14);
    box-shadow: 0 24px 70px rgba(7, 16, 27, 0.08);
  }

  .water-category-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .water-category-media p {
    margin: 0;
    padding: 0 24px 24px;
    color: #56625b;
    font-size: 16px;
    line-height: 1.7;
    align-self: center;
  }

  .water-category-inquiry :global(.product-hero-form-card) {
    height: 100%;
  }

  .water-category-inquiry :global(.product-hero-form) {
    min-height: 100%;
  }

  .water-category-section-head {
    display: grid;
    gap: 10px;
    max-width: 820px;
    margin: 0 auto 28px;
    text-align: center;
    justify-items: center;
  }

  .water-category-section-head h2,
  .water-guide-grid h2 {
    margin: 0;
    color: #101815;
    font-family: "Space Grotesk", sans-serif;
    font-size: 42px;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .water-category-section-head span {
    color: #606b64;
    font-size: 16px;
    line-height: 1.6;
  }

  .water-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .water-product-card {
    display: grid;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(57, 93, 61, 0.14);
    box-shadow: 0 16px 48px rgba(7, 16, 27, 0.07);
  }

  .water-product-link {
    display: grid;
    color: inherit;
  }

  .water-product-card figure {
    margin: 0;
    aspect-ratio: 1 / 1;
    background: #f4f6f2;
    overflow: hidden;
  }

  .water-product-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .water-product-body {
    display: grid;
    gap: 8px;
    padding: 18px 18px 16px;
  }

  .water-product-body h3 {
    margin: 0;
    color: #101815;
    font-family: "Space Grotesk", sans-serif;
    font-size: 17px;
    line-height: 1.12;
    letter-spacing: 0;
    text-align: center;
  }

  .water-product-quote {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    margin: 0 18px 18px;
    background: #395d3d;
    color: #fff;
    font-size: 13px;
    font-weight: 900;
  }

  .water-category-flow {
    background: #fff;
  }

  .water-flow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .water-flow-grid article,
  .water-guide-cards article {
    display: grid;
    gap: 10px;
    background: #fff;
    border: 1px solid rgba(57, 93, 61, 0.14);
  }

  .water-flow-grid article {
    gap: 0;
    overflow: hidden;
  }

  .water-flow-grid img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: center;
    background: #eef3ed;
  }

  .water-flow-card-body {
