---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Template1 from '@/components/Template1.astro';
import WaterBottlingTechnicalParameters from '@/components/WaterBottlingTechnicalParameters.astro';
import { countryDialOptions, defaultCountryName } from '@/data/countryDialOptions';

export const prerender = true;

const productName = '4000BPH 水灌装机';
const productSlug = '4000bph-water-filling-machine';
const assetBase = `/assets/first-machinery/products/water-filling-machine/${productSlug}`;
const productUrl = 'https://spring-pack.cn/products/filling-machine/water-filling-machine/4000bph-water-filling-machine/';
const supplierName = '中科美利（苏州）包装设备有限公司';

const heroGallery = [
  {
    src: '/assets/first-machinery/products/water-filling-machine/category/4000bph-water-filling-machine-cover.webp',
    alt: '4000BPH XGF14-12-5 automatic bottled water filling machine for PET bottle production',
    label: 'Main machine image',
  },
  {
    src: `${assetBase}/4000bph-water-filling-machine-hero-02.webp`,
    alt: 'Stainless steel rotary section of the 4000BPH water filling machine from supplier gallery',
    label: 'Rotary filling section',
  },
  {
    src: `${assetBase}/4000bph-water-filling-machine-hero-03.webp`,
    alt: 'Top view of the rinsing filling and capping monoblock for 4000BPH bottled water line',
    label: 'Monoblock top view',
  },
  {
    src: `${assetBase}/4000bph-water-filling-machine-hero-04.webp`,
    alt: 'Conveyor and transfer section detail on the 4000BPH water filling machine',
    label: 'Transfer section',
  },
  {
    src: `${assetBase}/4000bph-water-filling-machine-hero-05.webp`,
