const machineDetailsOverview = {
  image: `${assetBase}/4000bph-water-filling-machine-machine-details-overview.webp`,
  alt: 'Internal view of the 4000BPH 自动水灌装机 rinsing filling and capping monoblock',
};

const machineAdvantages = [
  {
    icon: 'monoblock',
    title: '卫生型三合一主机',
    text: '冲洗、灌装和封盖集中在同一台不锈钢主机内完成，减少瓶子转移环节，产线更紧凑，也更便于清洁维护。',
  },
  {
    icon: 'output',
    title: '3,000-4,000 BPH稳定产能',
    text: '该型号适合中小型水厂和大型瓶装水工厂，可根据瓶型、瓶盖和车间布局配置对应的输送、贴标和包装速度。',
  },
  {
    icon: 'range',
    title: '适配100ml-1.5L PET瓶',
    text: '适用于纯净水和矿泉水灌装项目，正式报价前会结合瓶样、瓶口、盖型和标签形式确认最终配置。',
  },
];

const machineDetails = [
  {
    title: '自动冲瓶系统',
    text: '瓶子进入灌装前进行内部冲洗，减少瓶内灰尘和杂质，保障饮用水灌装卫生。',
