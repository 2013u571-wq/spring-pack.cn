const heroStats = [
  ['产能', '3,000-4,000 BPH'],
  ['适用瓶型', '100ml-1.5L PET'],
  ['灌装头数', '14个'],
  ['设备类型', '三合一'],
];

const keySpecs = [
  ['产品型号', '4000BPH 水灌装机'],
  ['产能范围', '3,000-4,000 BPH'],
  ['适用瓶型', 'PET圆瓶或方瓶，最终以瓶样和图纸确认为准'],
  ['适用容量', '100ml-1.5L'],
  ['灌装物料', '纯净水、矿泉水、山泉水等非含气饮用水'],
  ['设备结构', '冲洗、灌装、封盖三合一单机，灌装头数14个'],
