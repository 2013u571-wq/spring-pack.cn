    width: 1400,
    height: 788,
  },
  {
    title: '高速回流灌装阀',
    text: '灌装阀控制液位稳定，灌装精度高，适合连续生产中的瓶装水液位一致性要求。',
    image: `${assetBase}/4000bph-water-filling-machine-high-speed-reflux-filling-valve-detail.webp`,
    alt: '瓶装水精准灌装阀细节',
    width: 960,
    height: 960,
  },
  {
    title: '自动旋盖系统',
    text: '自动理盖、送盖和旋盖，提高封盖效率，并保持瓶盖锁紧效果稳定。',
    image: `${assetBase}/4000bph-water-filling-machine-automatic-capping-system-detail.webp`,
    alt: '4000BPH 水灌装机自动旋盖系统细节',
    width: 960,
    height: 960,
  },
];

const lineModules = [
  {
    title: '水处理系统',
    text: '前处理可配置原水箱、石英砂过滤器、活性炭过滤器、精密过滤器、RO反渗透、紫外线杀菌、臭氧系统和成品水箱。',
    image: `${assetBase}/4000bph-water-filling-machine-water-treatment-system.webp`,
    alt: '瓶装纯净水生产线RO水处理系统',
  },
  {
    title: '贴标机',
    text: '可根据包装设计选择PVC套标、OPP热熔胶贴标、不干胶贴标或冷胶纸标等方案。',
    image: `${assetBase}/4000bph-water-filling-machine-labeling-machine.webp`,
    alt: '瓶装水生产线连接贴标机',
  },
  {
    title: '包装系统',
    text: '产线可连接膜包机、纸箱包装、托盘膜包等后段包装设备，满足不同销售渠道的包装需求。',
    image: `${assetBase}/4000bph-water-filling-machine-packaging-system.webp`,
    alt: '瓶装水后段包装系统',
  },
  {
    title: '吹瓶机',
    text: '吹瓶设备可在灌装前生产矿泉水瓶、饮料瓶和其他PET容器，便于组成完整瓶装水生产线。',
    image: `${assetBase}/4000bph-water-filling-machine-bottle-blowing-machine.webp`,
    alt: '灌装前PET瓶吹瓶机',
  },
];

const related解决方案 = [
  {
    title: '非含气饮料生产线',
    text: '适用于果汁、茶饮、功能饮料和含果肉饮料项目，需要采用不同的前处理和灌装设计。',
    capacity: '1,000-30,000BPH',
    image: `${assetBase}/4000bph-water-filling-machine-non-carbonated-beverage-line.webp`,
    alt: '果汁茶饮和功能饮料灌装项目非含气饮料生产线',
  },
  {
    title: '碳酸饮料生产线',
    text: '适用于苏打水、气泡饮料和碳酸软饮料生产，需要按含气产品配置等压灌装系统。',
    capacity: '1,000-20,000BPH',
    image: `${assetBase}/4000bph-water-filling-machine-carbonated-drink-line.webp`,
    alt: '苏打水和气泡饮料碳酸饮料灌装线',
  },
  {
    title: '3-5加仑桶装水生产线',
    text: '适用于周转桶装水生产，可完成3加仑至5加仑大桶的清洗、灌装和封盖。',
    capacity: '60-2,000BPH',
    image: `${assetBase}/4000bph-water-filling-machine-3-5-gallon-water-line.webp`,
    alt: '3至5加仑桶装水灌装线方案',
  },
];

const processSteps = [
  ['水处理', '原水根据当地水质经过过滤、反渗透、紫外线或臭氧处理，达到灌装要求。'],
  ['瓶子供应', 'PET瓶可由吹瓶机在线供应，也可人工上瓶后进入灌装主机。'],
  ['瓶内冲洗', '冲瓶系统在灌装前清洁瓶内表面，减少灰尘和异物。'],
  ['饮用水灌装', '非含气饮用水通过14个灌装头完成稳定灌装，保持液位一致。'],
  ['旋盖封口', '瓶盖自动整理、输送并旋紧，成品瓶随后进入贴标和包装工段。'],
];

const faqs = [
  {
    question: '4000BPH水灌装机可以灌装哪些产品？',
    answer: '该设备适用于非含气瓶装饮用水，包括纯净水、矿泉水、山泉水和普通饮用水。碳酸饮料或果汁通常需要不同的处理和灌装方案。',
  },
  {
    question: '这台设备适合哪些瓶型规格？',
    answer: '该型号适用于100ml-1.5L PET瓶。正式配置需根据瓶样、瓶口、盖型、标签形式和是否需要多规格切换来确认。',
  },
  {
    question: '是否可以作为完整生产线报价？',
    answer: '可以。可按项目需求配置水处理、吹瓶、灌装、喷码、贴标、包装和码垛等设备，组成完整瓶装水生产线。',
  },
  {
    question: '采购前需要确认哪些信息？',
    answer: '建议确认原水水质、瓶型容量、瓶样图纸、瓶盖类型、目标产能、当地电压、车间尺寸、安装计划以及是否需要单机或整线方案。',
  },
  {
    question: '页面参数是否就是最终报价参数？',
    answer: '页面参数用于选型参考，最终型号、速度、尺寸、功率和布局需结合瓶型、产线范围和项目现场条件确认。',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description:
    '4000BPH 水灌装机适用于PET瓶装纯净水和矿泉水生产，集冲洗、灌装和封盖于一体，可连接水处理、贴标和包装设备。',
  image: heroGallery.map((image) => new URL(image.src, 'https://spring-pack.cn').toString()),
  brand: {
    '@type': 'Brand',
    name: 'First Machinery',
  },
  manufacturer: {
    '@type': 'Organization',
    name: '中科美利（苏州）包装设备有限公司',
  },
  category: '水灌装机',
  sku: '4000BPH-WATER-FILLING-MACHINE',
  additionalProperty: keySpecs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};
---

<BaseLayout
  title={`${productName} | 三合一瓶装水灌装生产线`}
  description="4000BPH 水灌装机适用于PET瓶装纯净水和矿泉水生产，瓶型范围100ml-1.5L，可组成完整瓶装水生产线。"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="product-detail-page product-detail-page--rich product-detail-page--square-hero">
    <section class="product-hero product-hero--rich">
      <div class="container product-rich-hero-inner">
        <div class="product-hero-breadcrumb-bar">
          <nav class="product-breadcrumb" aria-label="面包屑导航">
            <a href="/">首页</a>
            <span>/</span>
            <a href="/products/">产品</a>
            <span>/</span>
            <a href="/products/filling-machine/water-filling-machine/">水灌装机</a>
          </nav>
        </div>

        <div class="product-hero-heading">
          <p class="product-kicker">瓶装水灌装生产线</p>
          <h1>{productName}</h1>
        </div>

        <dl class="product-rich-stats" aria-label="产品关键参数">
          {heroStats.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>

        <div class="product-hero-content">
          <div class="product-hero-showcase">
            <div class="product-hero-gallery" data-product-gallery>
              <div class="product-hero-thumbs" role="tablist" aria-label="4000BPH水灌装机图片">
                {heroGallery.map((image, index) => (
                  <button
                    class:list={['product-hero-thumb', index === 0 && 'is-active']}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-label={`查看 ${image.label}`}
                    data-gallery-thumb
                    data-gallery-index={String(index)}
                    data-gallery-src={image.src}
                    data-gallery-alt={image.alt}
                  >
                    <img src={image.src} alt={`${image.alt} 缩略图`} width="120" height="120" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
                  </button>
                ))}
              </div>
              <div class="product-hero-frame">
                <button class="product-hero-gallery-btn product-hero-gallery-btn--prev" type="button" aria-label="上一张产品图片" data-gallery-prev>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15 18 9 12l6-6"></path>
                  </svg>
                </button>
                <div class="product-hero-media">
                  <img
                    src={heroGallery[0].src}
                    alt={heroGallery[0].alt}
                    width="960"
                    height="960"
                    loading="eager"
                    decoding="async"
                    data-gallery-main
                  />
                  <div class="product-hero-cert-badges" aria-label="认证标识">
                    <span>CE</span>
                    <span>ISO</span>
                    <span>SGS</span>
                    <span>CNAS</span>
                  </div>
                </div>
                <button class="product-hero-gallery-btn product-hero-gallery-btn--next" type="button" aria-label="下一张产品图片" data-gallery-next>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="product-hero-form-card" id="quote">
            <div class="product-hero-intro-card">
              <p class="product-hero-intro-eyebrow">产品简介</p>
              <h2>4000BPH 水灌装机</h2>
              <p>
                这款水灌装机（产能3000-4000瓶/小时）专为PET瓶装水生产设计，适用于100毫升至1.5升容量的瓶子。它适用于纯净饮用水和矿泉水的灌装。该机器集冲洗、灌装和封盖于一体，运行稳定，灌装精准，易于维护。它可以与水处理、贴标和包装设备连接，形成完整的瓶装水生产线。广泛应用于中小型水厂以及大型瓶装水工厂。
              </p>
              <a class="product-hero-phone-button" href="tel:18962223666" aria-label="拨打电话 18962223666">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
                </svg>
                电话咨询：18962223666
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-summary-strip">
      <div class="container product-summary-grid">
        <div>
          <p class="product-kicker">企业实力</p>
          <h2 class="section-title--secondary">20余年行业经验，提供可靠的整线解决方案</h2>
        </div>
        <div class="product-summary-cards">
          <div><strong>20+</strong><span>年行业经验<small>丰富的设备制造与项目实施经验</small></span></div>
          <div><strong>整线</strong><span>交钥匙方案<small>从方案设计到安装调试一站式服务</small></span></div>
          <div><strong>CE / ISO</strong><span>国际认证<small>严格质量管理，符合国际标准</small></span></div>
          <div><strong>50+</strong><span>国家和地区<small>设备远销全球，提供完善售后支持</small></span></div>
        </div>
      </div>
    </section>

    <section class="product-section product-overview product-section--white" id="overview">
      <div class="container product-overview-layout">
        <div class="product-overview-head">
          <div>
            <p class="product-kicker">产品概述</p>
            <h2 class="section-title--primary">适合瓶装水工厂的中等产能生产线</h2>
          </div>
          <div class="product-overview-copy">
            <p>
              4000BPH 水灌装机适用于PET瓶装纯净水、矿泉水和山泉水生产，适用容量为100ml-1.5L，产能范围为3,000-4,000 BPH。设备既可作为单台灌装主机使用，也可与水处理、吹瓶、贴标、包装和码垛设备连接，组成完整瓶装水生产线。
            </p>
          </div>
        </div>
        <div class="product-line-flow-group">
          <figure class="product-layout-figure">
            <img
              src={`${assetBase}/4000bph-water-filling-machine-complete-line-layout.webp`}
              alt="完整 water bottling line layout from water treatment to filling labeling packing and palletizing"
              width="1710"
              height="805"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="product-process-caption-strip" aria-label="瓶装水生产线流程">
            {processSteps.map(([title, text], index) => (
              <div class="product-process-item">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-spec-section" id="specifications">
      <div class="container">
        <details class="product-spec-disclosure" open>
          <summary>
            <span class="product-spec-summary-copy">
              <span class="product-kicker">技术参数</span>
              <span class="section-title--primary">4000BPH 水灌装机参数</span>
            </span>
            <span class="product-spec-summary-toggle" aria-hidden="true"></span>
          </summary>
          <div class="product-spec-disclosure-body">
            <WaterBottlingTechnicalParameters />
          </div>
        </details>
      </div>
    </section>

    <section class="product-section product-feature-section">
      <div class="container">
        <div class="product-section-head">
          <p class="product-kicker">设备细节</p>
          <h2 class="section-title--secondary">采购方重点关注的核心部件</h2>
        </div>
        <div class="product-machine-detail-layout">
          <div class="product-machine-detail-lead">
            <figure class="product-machine-detail-main">
              <img
                src={machineDetailsOverview.image}
                alt={machineDetailsOverview.alt}
                width="960"
                height="627"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="product-machine-detail-summary">
              {machineAdvantages.map((item) => (
                <article>
                  <span class="product-machine-detail-icon" aria-hidden="true">
                    {item.icon === 'monoblock' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <rect x="7" y="12" width="34" height="24" rx="3"></rect>
                        <path d="M14 19h5m5 0h5m5 0h2M14 29h20"></path>
                        <path d="M16 36v5m16-5v5"></path>
                        <circle cx="19" cy="24" r="2.5"></circle>
                        <circle cx="29" cy="24" r="2.5"></circle>
                      </svg>
                    )}
                    {item.icon === 'output' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <path d="M8 32h6l4-11 6 17 5-14 4 8h7"></path>
                        <path d="M10 12h28v24H10z"></path>
                        <path d="M16 41h16"></path>
                      </svg>
                    )}
                    {item.icon === 'range' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <path d="M13 18h22"></path>
                        <path d="M18 12 12 18l6 6"></path>
                        <path d="m30 12 6 6-6 6"></path>
                        <path d="M17 31c0-3 2-5 4-6v-4h6v4c2 1 4 3 4 6v7H17z"></path>
                        <path d="M20 38h8"></path>
                      </svg>
                    )}
                  </span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))}
            </div>
