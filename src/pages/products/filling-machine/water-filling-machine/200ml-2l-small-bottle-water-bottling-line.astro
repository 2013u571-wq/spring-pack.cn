const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description:
    'Automatic 200ML-2L small bottle water bottling line for purified water, mineral water and spring water PET bottles, with water treatment, bottle blowing, 3-in-1 washing filling capping, labeling and packing modules.',
  image: heroGallery.map((image) => new URL(image.src, 'https://spring-pack.cn').toString()),
  brand: {
    '@type': 'Brand',
    name: 'First Machinery',
  },
  manufacturer: {
    '@type': 'Organization',
    name: '中科美利（苏州）包装设备有限公司',
  },
  category: '水灌装机',
  sku: '200ML-2L-WATER-FILLING-MACHINE',
  additionalProperty: keySpecs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};
---

<BaseLayout
  title={`${productName} | 3合1 瓶装水灌装线`}
  description="200ML-2L小瓶水灌装生产线，适用于纯净水、矿泉水和山泉水PET瓶。含技术规格、完整产线模块和报价方案规划。"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="product-detail-page product-detail-page--rich product-detail-page--square-hero product-detail-page--compact-title">
    <section class="product-hero product-hero--rich">
      <div class="container product-rich-hero-inner">
        <div class="product-hero-breadcrumb-bar">
          <nav class="product-breadcrumb" aria-label="Breadcrumb">
            <a href="/">首页</a>
            <span>/</span>
            <a href="/products/">产品中心</a>
            <span>/</span>
            <a href="/products/filling-machine/water-filling-machine/">水灌装机</a>
          </nav>
        </div>

        <div class="product-hero-heading">
          <p class="product-kicker">紧凑型瓶装水生产线</p>
          <h1>{productName}</h1>
        </div>

        <dl class="product-rich-stats" aria-label="Key product metrics">
          {heroStats.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>

        <div class="product-hero-content">
          <div class="product-hero-showcase">
            <div class="product-hero-gallery" data-product-gallery>
              <div class="product-hero-thumbs" role="tablist" aria-label="200ML-2L water filling machine images">
                {heroGallery.map((image, index) => (
                  <button
                    class:list={['product-hero-thumb', index === 0 && 'is-active']}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-label={`显示 ${image.label}`}
                    data-gallery-thumb
                    data-gallery-index={String(index)}
                    data-gallery-src={image.src}
                    data-gallery-alt={image.alt}
                  >
                    <img src={image.src} alt={`${image.alt} 缩略图`} width="120" height="120" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
                  </button>
                ))}
              </div>
              <div class="product-hero-frame">
                <button class="product-hero-gallery-btn product-hero-gallery-btn--prev" type="button" aria-label="上一张产品图片" data-gallery-prev>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15 18 9 12l6-6"></path>
                  </svg>
                </button>
                <div class="product-hero-media">
                  <img
                    src={heroGallery[0].src}
                    alt={heroGallery[0].alt}
                    width="960"
                    height="960"
                    loading="eager"
                    decoding="async"
                    data-gallery-main
                  />
                  <div class="product-hero-cert-badges" aria-label="Certification badges">
                    <span>CE</span>
                    <span>ISO</span>
                    <span>SGS</span>
                    <span>CNAS</span>
                  </div>
                </div>
                <button class="product-hero-gallery-btn product-hero-gallery-btn--next" type="button" aria-label="下一张产品图片" data-gallery-next>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="product-hero-form-card" id="quote">
                        <form class="product-hero-form product-hero-form--compact-wufoo" data-lead-form novalidate>
              <div class="lead-eyebrow">获取方案</div>
              <p>
                提交您的联系方式和项目需求。工程师将评估产线范围并回复配置详情。
              </p>

              <label class="product-hero-form-field product-hero-form-field--half">
                <span>姓名 <b>*</b></span>
                <input name="name" type="text" autocomplete="name" placeholder="请输入姓名" required />
                <em data-error-for="name">请输入您的姓名。</em>
              </label>

              <label class="product-hero-form-field product-hero-form-field--half">
                <span>邮箱 <b>*</b></span>
                <input name="email" type="email" autocomplete="email" placeholder="name@company.com" required />
                <em data-error-for="email">请输入有效邮箱。</em>
              </label>

              <label class="product-hero-form-field product-hero-form-field--half">
                <span>WhatsApp <b>*</b></span>
                <div class="product-hero-phone-control">
                  <select name="country" autocomplete="country-name" required aria-label="国家区号">
                    {countryDialOptions.map((item) => (
                      <option value={item.country} data-dial={item.code} selected={item.country === defaultCountryName}>
                        {item.flag} {item.code}
                      </option>
                    ))}
                  </select>
                  <input name="whatsapp" type="tel" autocomplete="tel" placeholder="555 000 0000" required />
                </div>
                <em data-error-for="whatsapp">请输入您的 WhatsApp 号码。</em>
              </label>

              <label class="product-hero-form-field product-hero-form-field--half">
                <span>产品类型</span>
                <select name="product">
                  <option value="纯净水 / 矿泉水" selected>纯净水 / 矿泉水</option>
                  <option value="果汁 / 茶饮 / 功能饮料">果汁 / 茶饮 / 功能饮料</option>
                  <option value="碳酸饮料">碳酸饮料</option>
                  <option value="食用油">食用油</option>
                  <option value="酱料 / 调味品">酱料 / 调味品</option>
                  <option value="其他液体">其他液体</option>
                </select>
              </label>

              <label class="product-hero-form-message">
                <span>项目需求 <b>*</b></span>
                <textarea
                  name="message"
                  placeholder="瓶子规格、目标产能、水源、电压、产线范围..."
                  required
                ></textarea>
                <em data-error-for="message">请描述您的项目需求。</em>
              </label>

              <label class="product-hero-form-attachment">
                <span>附件</span>
                <input
                  name="attachment"
                  type="file"
                  accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.zip"
                />
                <em data-error-for="attachment">附件需为 PDF、Office、图片、WebP 或 ZIP，且不超过 8 MB。</em>
              </label>

              <input type="hidden" name="sourcePage" value="" />
              <input type="hidden" name="sourceTitle" value="" />
              <input type="hidden" name="source" value="hero-product-form" />
              <input type="hidden" name="referrer" value="" />

              <button class="lead-submit" type="submit">获取报价</button>

              <div class="product-hero-form-trust" aria-label="方案支持">
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="8"></circle>
                    <path d="M12 7v5l3 2"></path>
                  </svg>
                  24小时回复
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 12.5 11 15l5-6"></path>
                    <path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"></path>
                  </svg>
                  工程师评估
                </span>
              </div>
              <p class="lead-status" data-lead-status role="status" aria-live="polite">无需承诺。</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-summary-strip">
      <div class="container product-summary-grid">
        <div>
          <p class="product-kicker">企业实力</p>
          <h2 class="section-title--secondary">20余年行业经验，提供可靠的整线解决方案</h2>
        </div>
        <div class="product-summary-cards">
          <div><strong>20+</strong><span>年行业经验<small>丰富的设备制造与项目实施经验</small></span></div>
          <div><strong>整线</strong><span>交钥匙方案<small>从方案设计到安装调试一站式服务</small></span></div>
          <div><strong>CE / ISO</strong><span>国际认证<small>严格质量管理，符合国际标准</small></span></div>
          <div><strong>50+</strong><span>国家和地区<small>设备远销全球，提供完善售后支持</small></span></div>
        </div>
      </div>
    </section>

    <section class="product-section product-overview product-section--white" id="overview">
      <div class="container product-overview-layout">
        <div class="product-overview-head">
          <div>
            <p class="product-kicker">产品中心 产品概述</p>
          <h2 class="section-title--primary">小规模水厂实用首条产线</h2>
          </div>
