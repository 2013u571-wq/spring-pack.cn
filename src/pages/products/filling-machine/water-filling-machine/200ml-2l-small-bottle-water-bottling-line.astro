    image: `${assetBase}/200ml-2l-small-bottle-water-bottling-line-labeling-machine.webp`,
    alt: '瓶装水生产线配套贴标机',
  },
  {
    title: '包装系统',
    text: '该产线可对接薄膜收缩包装、纸箱包装、带托盘薄膜包装及其他最终包装方案。',
    image: `${assetBase}/200ml-2l-small-bottle-water-bottling-line-packaging-system.webp`,
