  {
    title: '吹瓶机',
    text: '吹瓶设备可生产用于灌装前的矿泉水瓶、饮料瓶、软饮瓶及其他PET容器。',
    image: `${assetBase}/200ml-2l-small-bottle-water-bottling-line-bottle-blowing-machine.webp`,
    alt: '灌装前用于水瓶生产的PET吹瓶机',
  },
];

