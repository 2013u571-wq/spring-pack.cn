  {
    title: '不含气饮料生产线',
    text: '适用于果汁、茶饮、能量饮料和含果粒饮料项目，需要不同的灌装和工艺设计。',
    capacity: '1,000-30,000BPH',
    image: `${assetBase}/200ml-2l-small-bottle-water-bottling-line-non-carbonated-beverage-line.webp`,
    alt: '不含气饮料生产线，适用于果汁、茶饮和能量饮料灌装项目',
  },
  {
    title: '碳酸饮料生产线',
    text: '适用于苏打水、气泡饮料和碳酸软饮料生产，需要等压灌装工艺。',
    capacity: '1,000-20,000BPH',
    image: `${assetBase}/200ml-2l-small-bottle-water-bottling-line-carbonated-drink-line.webp`,
    alt: '苏打水和气泡饮料碳酸灌装线',
  },
  {
    title: '3-5加仑桶装水生产线',
    text: '适用于可回收桶装水生产，完成3至5加仑大桶的冲洗、灌装和封口。',
    capacity: '60-2,000BPH',
    image: `${assetBase}/200ml-2l-small-bottle-water-bottling-line-3-5-gallon-water-line.webp`,
    alt: '3至5加仑桶装水灌装线方案',
  },
];

const processSteps = [
  ['水处理', '原水根据当地水质通过过滤、反渗透、紫外线或臭氧处理。'],
  ['供瓶', 'PET瓶从吹瓶或人工上料进入，输送至灌装一体机。'],
  ['洗瓶', '冲洗系统在灌装前对瓶内壁进行清洁。'],
  ['灌装', '静水通过选定的XGF阀组灌装，实现液位控制和稳定的生产节奏。'],
  ['封盖', '瓶盖经理盖、送盖和旋紧后，成品瓶进入贴标和包装工位。'],
];

const faqs = [
  {
    question: '这条200ML-2L产线可以灌装哪些产品？',
    answer: '该产线专为静水瓶装水设计，包括纯净水、矿泉水、山泉水和饮用净水。碳酸饮料或果汁通常需要不同的工艺和灌装设计。',
  },
  {
    question: '能否处理不同瓶型规格？',
    answer: '本项目聚焦200ml至2L PET瓶。实际范围需根据瓶型图纸、瓶口规格、瓶盖类型、标签样式和目标产能确认。',
  },
  {
    question: '能否按完整生产线报价？',
    answer: '可以。源标题将该方案定位为全自动灌装工厂和完整生产设备线，因此报价可包含水处理、吹瓶、灌装、贴标、打码、包装和码垛衔接。',
  },
  {
    question: '下单前需要确认哪些事项？',
    answer: '确认水源水质、瓶型容量、瓶型图纸、瓶盖类型、目标产能、当地电压、车间尺寸、安装方案，以及是仅需灌装还是整线需求。',
  },
  {
    question: '列出的参数是否为最终报价依据？',
    answer: '阿里巴巴在本次建站期间屏蔽了实时数据提取，因此本页面将目标产品ID和标题与本地缓存的Spring Pack水线数据组合呈现。具体型号命名、产能、重量和最终布局应在报价前核实。',
  },
