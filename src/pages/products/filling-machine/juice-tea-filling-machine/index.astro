---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const heroBackground = '/assets/first-machinery/products/juice-tea-filling-machine/category/pet-bottle-juice-filling-hero.webp';

const products = [
  {
    name: '2000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/2000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/2000bph-juice-filling-machine/2000bph-juice-filling-machine-main.webp',
    alt: '2000BPH果汁茶饮热灌装生产线',
  },
  {
    name: '4000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/4000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/4000bph-juice-filling-machine/4000bph-juice-filling-machine-main.webp',
    alt: '4000BPH PET瓶果汁茶饮灌装生产线',
  },
  {
    name: '6000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/6000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/6000bph-juice-filling-machine/6000bph-juice-filling-machine-main.webp',
    alt: '6000BPH非含气饮料自动灌装机',
  },
  {
    name: '12000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/12000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/12000bph-juice-filling-machine/12000bph-juice-filling-machine-main.webp',
    alt: '12000BPH果汁茶饮瓶装热灌装线',
  },
  {
    name: '15000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/15000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/15000bph-juice-filling-machine/15000bph-juice-filling-machine-main.webp',
    alt: '15000BPH果汁饮料和茶饮灌装生产线',
  },
  {
    name: '20000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/20000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/20000bph-juice-filling-machine/20000bph-juice-filling-machine-main.webp',
    alt: '20000BPH大型果汁茶饮瓶装生产线',
  },
  {
    name: '24000BPH 果汁灌装机',
    href: '/products/filling-machine/juice-tea-filling-machine/24000bph-juice-filling-machine/',
    image:
      '/assets/first-machinery/products/juice-tea-filling-machine/24000bph-juice-filling-machine/24000bph-juice-filling-machine-main.webp',
    alt: '24000BPH高速果汁饮料灌装生产线',
  },
];

const flowSteps = [
  {
    number: '01',
    title: '水处理',
    text: '为饮料生产配置水过滤、净化和储水系统。',
    image: '/assets/first-machinery/products/juice-tea-filling-machine/production-line-flow/water-treatment.webp',
  },
  {
    number: '02',
    title: '果汁调配',
    text: '完成果汁调配、过滤、均质和杀菌等前处理工艺。',
    image: '/assets/first-machinery/products/juice-tea-filling-machine/production-line-flow/juice-mixing.webp',
  },
  {
    number: '03',
    title: '吹瓶',
    text: 'PET瓶坯加热成型，适配不同瓶型设计和灌装速度。',
    image: '/assets/first-machinery/products/juice-tea-filling-machine/production-line-flow/bottle-blowing.webp',
  },
  {
    number: '04',
    title: '冲洗 灌装 封盖',
    text: '自动完成冲瓶、热灌装和稳定封盖，适合连续生产。',
    image: '/assets/first-machinery/products/juice-tea-filling-machine/production-line-flow/rinsing-filling-capping.webp',
  },
  {
    number: '05',
    title: '贴标喷码',
    text: '成品瓶可连接自动贴标和日期喷码设备。',
    image: '/assets/first-machinery/products/juice-tea-filling-machine/production-line-flow/labeling-coding.webp',
  },
  {
    number: '06',
    title: '包装系统',
    text: '可选择膜包、托盘包装或纸箱包装等后段方案。',
    image: '/assets/first-machinery/products/juice-tea-filling-machine/production-line-flow/packaging-system.webp',
  },
];
---

<BaseLayout
  title="果汁茶饮灌装机 | 热灌装饮料生产线"
  description="果汁茶饮灌装机分类页，覆盖2000BPH至24000BPH非含气饮料项目，支持整线规划、型号对比和方案报价。"
>
  <article class="water-category-page juice-category-page">
    <section class="water-category-hero" style={`--water-hero-bg: url(${heroBackground})`}>
      <div class="container">
        <nav class="water-category-breadcrumb" aria-label="面包屑导航">
          <a href="/" aria-label="首页">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 10.5 12 3l9 7.5"></path>
              <path d="M5.5 9.5V20h13V9.5"></path>
              <path d="M9.5 20v-6h5v6"></path>
            </svg>
            首页
          </a>
          <svg class="breadcrumb-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
          <a href="/products/">产品中心</a>
          <svg class="breadcrumb-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
          <a href="/products/filling-machine/">灌装机</a>
          <svg class="breadcrumb-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
          <span>果汁茶饮灌装机</span>
        </nav>

        <div class="water-category-hero-content">
          <p class="water-category-hero-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3C9 7.5 6 10.9 6 14.2A6 6 0 0 0 18 14.2C18 10.9 15 7.5 12 3z"></path>
            </svg>
            完整果汁茶饮灌装解决方案
          </p>
          <h1>果汁茶饮灌装机</h1>
          <p class="water-category-hero-subtitle">
            适用于 PET 瓶果汁、茶饮和不含气饮料产线的热灌装解决方案。
          </p>

          <div class="water-category-hero-features" aria-label="果汁茶饮灌装线亮点">
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 20V9"></path>
                <path d="M20 20V5"></path>
                <path d="M8 20V13"></path>
                <path d="M16 20V9"></path>
                <path d="M3 20h18"></path>
                <path d="M9 13h6"></path>
                <path d="M7 9h10"></path>
              </svg>
              <div>
                <strong>2000-24000BPH</strong>
                <span>产能范围</span>
              </div>
            </article>
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 3h6"></path>
                <path d="M10 3v4l-2 2v11h8V9l-2-2V3"></path>
                <path d="M8 13h8"></path>
                <path d="M8 17h8"></path>
              </svg>
              <div>
                <strong>PET瓶</strong>
                <span>瓶型规格</span>
              </div>
            </article>
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 3v3"></path>
                <path d="M12 18v3"></path>
                <path d="M3 12h3"></path>
                <path d="M18 12h3"></path>
                <path d="m5 5 2.2 2.2"></path>
                <path d="m16.8 16.8 2.2 2.2"></path>
                <path d="m19 5-2.2 2.2"></path>
                <path d="m7.2 16.8-2.2 2.2"></path>
              </svg>
              <div>
                <strong>热灌装</strong>
                <span>整线集成</span>
              </div>
            </article>
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"></path>
                <path d="m8.5 12 2.2 2.2 4.8-5"></path>
              </svg>
              <div>
                <strong>CE / ISO</strong>
                <span>认证品质</span>
              </div>
            </article>
          </div>

          <div class="water-category-hero-actions">
            <a class="water-category-primary-action" href="/contact/">
              获取方案
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="water-category-products" id="capacity">
      <div class="container">
        <div class="water-category-section-head">
          <span>先选择目标产能范围，再提交瓶型、盖型、饮料配方、灌装温度和产线范围等项目需求。</span>
        </div>

        <div class="water-product-grid">
          {products.map((product) => (
            <article class="water-product-card">
              <a class="water-product-link" href={product.href}>
                <figure>
                  <img src={product.image} alt={product.alt} width="960" height="960" loading="lazy" decoding="async" />
                </figure>
                <div class="water-product-body">
                  <h3>{product.name}</h3>
                </div>
              </a>
              <a class="water-product-quote" href={product.href}>
                获取报价
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="water-category-flow">
      <div class="container">
        <div class="water-category-section-head">
          <p>完整生产流程</p>
          <h2>典型果汁茶饮生产线范围</h2>
          <span>果汁茶饮生产线可按单台灌装设备报价，也可按从前处理到后段包装的完整整线配置。</span>
        </div>
        <div class="water-flow-grid">
          {flowSteps.map((step) => (
            <article>
              <img src={step.image} alt={`${step.title}设备`} loading="lazy" decoding="async" />
              <div class="water-flow-card-body">
                <div class="water-flow-card-heading">
                  <span>{step.number}</span>
                  <h3>{step.title}</h3>
                </div>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="water-category-guide">
      <div class="container water-guide-grid">
        <div>
          <p class="water-category-kicker">选型说明</p>
          <h2>如何选择果汁茶饮灌装线</h2>
        </div>
        <div class="water-guide-cards">
          <article>
            <h3>目标产能</h3>
            <p>确认每小时目标产量、班次计划和日饮料产量，便于匹配合适机型。</p>
          </article>
          <article>
            <h3>饮料配方</h3>
            <p>果汁、茶饮、含乳饮料和功能饮料配方会影响调配和杀菌工艺设计。</p>
          </article>
          <article>
            <h3>瓶型规格</h3>
            <p>确认PET瓶容量、瓶口规格、盖型、瓶形和灌装温度。</p>
          </article>
          <article>
            <h3>产线范围</h3>
            <p>确认只需要灌装设备，还是需要从前处理到最终包装的完整生产线。</p>
          </article>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .water-category-page {
    background: #f6f8f4;
  }

  .water-category-hero {
    position: relative;
    overflow: hidden;
    min-height: 450px;
    padding: 0;
    background-color: #fff;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.92) 34%, rgba(255, 255, 255, 0.58) 57%, rgba(255, 255, 255, 0.08) 82%),
      var(--water-hero-bg);
    background-position: center, center right;
    background-size: cover, cover;
    background-repeat: no-repeat;
  }

  .water-category-hero > .container {
    display: grid;
    min-height: 450px;
    align-content: start;
    padding-top: 26px;
    padding-bottom: 32px;
  }

  .water-category-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 0;
    color: #7c8580;
    font-size: 13px;
    font-weight: 700;
  }

  .water-category-breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #727c76;
  }

  .water-category-breadcrumb span {
    color: #4e8a5a;
  }

  .water-category-breadcrumb svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .water-category-breadcrumb .breadcrumb-chevron {
    width: 12px;
    height: 12px;
    color: #9aa39e;
  }

  .water-category-hero-content {
    display: grid;
    gap: 14px;
    width: min(880px, 58vw);
    margin-top: 38px;
  }

  .water-category-hero-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 16px;
    border: 1px solid rgba(77, 139, 90, 0.16);
    border-radius: 999px;
    background: rgba(226, 244, 231, 0.82);
    color: #4f8c5b;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .water-category-hero-badge svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.1;
  }

  .water-category-hero-content h1 {
    margin: 6px 0 0;
    color: #0d1915;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(46px, 3.7vw, 64px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .water-category-hero-subtitle {
    max-width: 500px;
    margin: 0;
    color: #626f69;
    font-size: clamp(16px, 1.18vw, 21px);
    font-weight: 400;
    line-height: 1.25;
  }

  .water-category-hero-features {
    display: grid;
    grid-template-columns: repeat(4, 180px);
    gap: 12px;
    margin-top: 0;
    width: fit-content;
    max-width: 100%;
  }

  .water-category-hero-features article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 50px;
    padding: 8px 12px;
    border: 1px solid rgba(53, 85, 61, 0.14);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 10px 26px rgba(8, 20, 16, 0.04);
    backdrop-filter: blur(12px) saturate(1.18);
    -webkit-backdrop-filter: blur(12px) saturate(1.18);
  }

  .water-category-hero-features article > svg {
    width: 19px;
    height: 19px;
    color: #416f49;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .water-category-hero-features strong,
  .water-category-hero-features span {
    display: block;
  }

  .water-category-hero-features strong {
    color: #26302b;
    font-size: 11px;
    font-weight: 900;
    line-height: 1.15;
  }

  .water-category-hero-features span {
    margin-top: 2px;
    color: #6d7772;
    font-size: 9px;
    font-weight: 700;
    line-height: 1.2;
  }

  .water-category-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  .water-category-primary-action {
    display: inline-flex;
    min-width: 180px;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border-radius: 10px;
    background: linear-gradient(135deg, #3f7b4d, #5da56d);
    color: #fff;
    box-shadow: 0 14px 34px rgba(50, 106, 62, 0.24);
    font-size: 13px;
    font-weight: 900;
    line-height: 1;
  }

  .water-category-primary-action svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .water-category-kicker,
  .water-category-section-head p {
    margin: 0;
    color: #395d3d;
    font: 800 12px/1 "IBM Plex Mono", monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .water-category-intro,
  .water-category-products,
  .water-category-flow,
  .water-category-guide {
    padding: clamp(50px, 7vw, 86px) 0;
  }

  .water-category-intro {
    padding-bottom: 32px;
  }

  .water-category-products {
    padding-top: clamp(44px, 5vw, 72px);
  }

  .water-category-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(380px, 0.72fr);
    gap: 28px;
    align-items: stretch;
  }

  .water-category-media {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 18px;
    height: 100%;
    background: #fff;
    border: 1px solid rgba(57, 93, 61, 0.14);
    box-shadow: 0 24px 70px rgba(7, 16, 27, 0.08);
  }

  .water-category-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .water-category-media p {
    margin: 0;
    padding: 0 24px 24px;
    color: #56625b;
    font-size: 16px;
    line-height: 1.7;
    align-self: center;
  }

  .water-category-inquiry :global(.product-hero-form-card) {
    height: 100%;
  }

  .water-category-inquiry :global(.product-hero-form) {
    min-height: 100%;
  }

  .water-category-section-head {
    display: grid;
    gap: 10px;
    max-width: 820px;
    margin: 0 auto 28px;
    text-align: center;
    justify-items: center;
  }

  .water-category-section-head h2,
  .water-guide-grid h2 {
    margin: 0;
    color: #101815;
    font-family: "Space Grotesk", sans-serif;
    font-size: 42px;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .water-category-section-head span {
    color: #606b64;
    font-size: 16px;
    line-height: 1.6;
  }

  .water-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .water-product-card {
    display: grid;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(57, 93, 61, 0.14);
    box-shadow: 0 16px 48px rgba(7, 16, 27, 0.07);
  }

  .water-product-link {
    display: grid;
    color: inherit;
  }

  .water-product-card figure {
    margin: 0;
    aspect-ratio: 1 / 1;
    background: #f4f6f2;
    overflow: hidden;
  }

  .water-product-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .water-product-body {
    display: grid;
    gap: 8px;
    padding: 18px 18px 16px;
  }

  .water-product-body h3 {
    margin: 0;
    color: #101815;
    font-family: "Space Grotesk", sans-serif;
    font-size: 17px;
    line-height: 1.12;
    letter-spacing: 0;
    text-align: center;
  }

  .water-product-quote {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    margin: 0 18px 18px;
    background: #395d3d;
    color: #fff;
    font-size: 13px;
    font-weight: 900;
  }

  .water-category-flow {
    background: #fff;
  }

  .water-flow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .water-flow-grid article,
  .water-guide-cards article {
    display: grid;
    gap: 10px;
    background: #fff;
    border: 1px solid rgba(57, 93, 61, 0.14);
  }

  .water-flow-grid article {
    gap: 0;
    overflow: hidden;
  }

  .water-flow-grid img {
    display: block;
    width: 100%;
    height: clamp(190px, 16vw, 240px);
    object-fit: cover;
    object-position: center;
    background: #eef3ed;
  }

  .water-flow-card-body {
    display: grid;
    gap: 10px;
    padding: 20px 22px 22px;
  }

  .water-flow-card-heading {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .water-flow-card-heading h3 {
    flex: 1;
  }

  .water-guide-cards article {
    padding: 22px;
  }

  .water-flow-grid span {
    display: inline-grid;
    width: 42px;
