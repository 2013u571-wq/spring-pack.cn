        </div>
        <div class="product-machine-detail-layout">
          <div class="product-machine-detail-lead">
            <figure class="product-machine-detail-main product-machine-detail-main--wide-crop">
              <img src={machineDetailsOverview.image} alt={machineDetailsOverview.alt} width="1400" height="788" loading="lazy" decoding="async" />
            </figure>
            <div class="product-machine-detail-summary">
              {machineAdvantages.map((item) => (
                <article>
                  <span class="product-machine-detail-icon" aria-hidden="true">
                    {item.icon === 'monoblock' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <rect x="7" y="12" width="34" height="24" rx="3"></rect>
                        <path d="M14 19h5m5 0h5m5 0h2M14 29h20"></path>
                        <path d="M16 36v5m16-5v5"></path>
