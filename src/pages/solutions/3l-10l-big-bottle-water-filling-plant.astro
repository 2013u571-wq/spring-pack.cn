---

<BaseLayout
  title={`${productName} | 大瓶水灌装方案`}
  description="3L-10L big bottle water filling plant for purified, mineral and spring water PET瓶. Includes technical specifications, complete line modules and quotation planning."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="product-detail-page product-detail-page--rich product-detail-page--square-hero product-detail-page--compact-title solution-line-page">
    <section class="product-hero product-hero--rich">
      <div class="container product-rich-hero-inner">
        <div class="product-hero-breadcrumb-bar">
          <nav class="product-breadcrumb" aria-label="Breadcrumb">
            <a href="/">首页</a>
            <span>/</span>
