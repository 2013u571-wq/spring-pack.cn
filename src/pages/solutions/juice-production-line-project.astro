---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Template1 from '@/components/Template1.astro';
import { countryDialOptions, defaultCountryName } from '@/data/countryDialOptions';

export const prerender = true;

const productName = '果汁生产线项目';
const productSlug = 'juice-production-line-project';
const assetBase = `/assets/first-machinery/solutions/${productSlug}`;
const productUrl = 'https://spring-pack.cn/solutions/juice-production-line-project/';
const supplierName = '苏州斯普瑞包装机械有限公司';
const alibabaProductTitle =
  '15000BPH juice filling machine reference for non-碳酸饮料 production';

const heroGallery = [
  {
    src: `${assetBase}/juice-production-line-project-product-overview.avif`,
    alt: '果汁茶饮生产线项目整体展示',
    label: '整体展示',
  },
  {
    src: `${assetBase}/juice-production-line-project-hero-01.webp`,
    alt: '配备自动冲洗灌装封盖机的果汁生产线项目',
    label: 'Main juice filling line',
  },
  {
    src: `${assetBase}/juice-production-line-project-hero-02.webp`,
    alt: 'Internal rotary filling section for juice and tea beverage production',
    label: '灌装 carousel',
  },
  {
    src: `${assetBase}/juice-production-line-project-hero-03.webp`,
    alt: '瓶transfer and filling valve detail for non-carbonated drink filling line',
    label: 'Valve section',
  },
  {
    src: `${assetBase}/juice-production-line-project-hero-04.webp`,
    alt: '工厂 workshop view of juice production line equipment',
    label: '自动 washing section',
  },
  {
    src: `${assetBase}/juice-production-line-project-hero-05.webp`,
    alt: 'Top cylinder and piping detail for juice filling machine',
    label: 'Top section',
  },
  {
    src: `${assetBase}/juice-production-line-project-hero-06.webp`,
    alt: '封盖 section and stainless steel monoblock for juice production line',
    label: '自动 capping section',
  },
];

const keySpecs = [
  ['参考产品', '15000BPH 果汁灌装机'],
  ['供应商产品标题', alibabaProductTitle],
  ['产能范围', '2,000-24,000BPH depending on selected RXGF model'],
  ['供应商型号', 'RXGF series automatic juice and tea filling line'],
  ['主要配置', '冲洗, hot filling, capping, bottle transfer and downstream line connection'],
  ['灌装物料', '果汁、茶饮、风味饮料、能量饮料及其他不含气饮料'],
  ['瓶身材质', 'PET瓶'],
  ['瓶型容量', '100ml-2L by common project configuration'],
  ['瓶型形状', '圆瓶或方瓶，按瓶样图纸确认'],
  ['灌装方式', '热灌装/非碳酸饮料灌装'],
  ['包装类型', '瓶子'],
  ['电压', '110V、220V、380V或415V'],
  ['自动化等级', '自动'],
  ['功能', '冲洗、灌装、封盖'],
  ['瓶径范围', '直径50-115mm'],
  ['瓶高范围', '160-320mm'],
  ['冲洗压力', '>0.06MPa且<0.2MPa'],
  ['应用', '果汁 / 茶饮 / 乳饮料'],
  ['材质', '接触物料部件可选SUS304 / SUS316'],
  ['核心部件', '电机、压力容器、泵、PLC、齿轮、轴承、齿轮箱、发动机和活塞'],
  ['质保', '供应商属性中为2年'],
  ['检测文件', '可提供设备测试报告和出厂检验视频'],
  ['售后支持', '视频技术支持、在线支持、现场安装调试培训、现场维护服务和免费备件'],
  ['产地', '中国江苏'],
];

const juiceTechColumns = ['RXGF12-12-5', 'RXGF18-18-6', 'RXGF24-24-8', 'RXGF32-32-10', 'RXGF40-40-15', 'RXGF50-50-18'];

const juiceTechRows = [
  ['产能（500ml）', '2000-4000BPH', '4000-6000BPH', '6000-12000BPH', '12000-15000BPH', '16000-20000BPH', '24000BPH'],
  ['适用瓶型', '圆瓶或方瓶'],
  ['瓶径范围', 'Dia. 50-115 mm'],
  ['瓶高度', '160-320 mm'],
  ['灌装方式', '热灌装'],
  ['功能', '冲洗、灌装、封盖'],
  ['冲洗压力', '0.06-0.2 MPa'],
  ['应用', '果汁 / 茶饮 / 乳饮料'],
  ['总功率', '4.4 kW', '4.4 kW', '5.2 kW', '6.2 kW', '7.8 kW', '9.4 kW'],
  ['外形尺寸', '2.3 x 1.9 m', '2.5 x 1.9 m', '2.8 x 2.15 m', '3.1 x 2.5 m', '3.8 x 2.8 m', '4.5 x 3.3 m'],
  ['高度', '2.3 m', '2.5 m', '2.5 m', '2.5 m', '2.5 m', '2.6 m'],
  ['重量', '3500 kg', '4500 kg', '7000 kg', '7500 kg', '8500 kg', '9500 kg'],
];

const machineDetailsOverview = {
  image: `${assetBase}/juice-production-line-project-machine-details-overview.webp`,
  alt: 'Main machine detail overview for juice production line project',
};

const machineAdvantages = [
  {
    icon: 'monoblock',
    title: '冲洗灌装封盖系统',
    text: '紧凑型一体机集瓶冲洗、饮料灌装和封盖于一体，减少转接环节并保持生产稳定。',
  },
  {
    icon: 'output',
    title: '灵活饮料产能',
    text: 'RXGF系列可按小型、中型及高产能非碳酸饮料项目选择，产能范围覆盖2,000BPH至24,000BPH。',
  },
  {
    icon: 'range',
    title: '果汁茶饮瓶装准备',
    text: '最终产线设计前会确认瓶型、盖型、产品配方、灌装温度和杀菌方式。',
  },
];

const machineDetails = [
  {
    title: '瓶子冲洗段',
    text: '灌装前对PET瓶进行冲洗，减少瓶内灰尘与杂质。',
    image: `${assetBase}/juice-production-line-project-bottle-rinsing-section.webp`,
    alt: '瓶子冲洗 section for juice production line project',
    width: 1200,
    height: 675,
  },
  {
    title: '果汁灌装段',
    text: '灌装段可根据果汁、茶饮、风味饮料等非碳酸产品配置。',
    image: `${assetBase}/juice-production-line-project-juice-filling-section.webp`,
    alt: '果汁灌装 section detail for non-碳酸饮料 production',
    width: 1200,
    height: 675,
  },
  {
    title: '封盖与输送',
    text: '瓶子输送、理盖和封盖可与后段贴标、包装设备联动。',
    image: `${assetBase}/juice-production-line-project-capping-section.webp`,
    alt: '封盖 and conveyor detail for juice production line project',
    width: 1200,
    height: 675,
  },
];

const lineModules = [
  {
    title: '水处理系统',
    text: '饮料调配前可配置多介质过滤、活性炭过滤、RO反渗透、UV、臭氧和成品水箱。',
    image: `${assetBase}/juice-production-line-project-workshop-line.webp`,
    alt: '水处理 and workshop line for juice production project',
  },
  {
    title: '果汁调配系统',
    text: '可根据产品配方和保质期要求配置调配罐、过滤器、杀菌系统和均质机。',
    image: `${assetBase}/juice-production-line-project-processing-system.webp`,
    alt: '带罐体、过滤和杀菌设备的果汁调配系统',
  },
  {
    title: '贴标机',
    text: '可根据瓶型设计选择套标、OPP热熔胶贴标、不干胶贴标和喷码系统。',
    image: `${assetBase}/juice-production-line-project-labeling-packaging.webp`,
    alt: '贴标 machine for PET bottled juice production line',
  },
  {
    title: '包装系统',
    text: '成品瓶可连接膜包、纸箱包装、托盘包装和输送系统，便于后续发货。',
    image: `${assetBase}/juice-production-line-project-bottle-conveyor.webp`,
    alt: 'Packaging system and bottle conveyor for juice production line project',
  },
  {
    title: '吹瓶机',
    text: 'PET吹瓶设备可在冲洗、灌装和封盖前供应空瓶，并按瓶容量和目标产能匹配。',
    image: '/assets/first-machinery/products/shared/bottle-blowing-machine.webp',
    alt: '吹瓶 machine module for PET juice bottle production',
  },
];

const processSteps = [
  ['饮料调配', '果汁或茶饮在灌装前完成调配、过滤、杀菌和暂存。'],
  ['瓶子冲洗', 'PET瓶进入灌装转盘前会先进行冲洗。'],
  ['果汁灌装', '产品根据配方和瓶型通过饮料灌装段完成灌装。'],
  ['瓶盖封口', '瓶盖经整理和输送后完成旋盖，瓶子再离开一体机。'],
  ['贴标与包装', '成品瓶可连接贴标、喷码、膜包或纸箱包装设备。'],
];

const faqs = [
  {
    question: '这条果汁生产线可以灌装哪些饮料？',
    answer: '适用于果汁、茶饮、风味饮料、能量饮料等PET瓶非碳酸饮品。',
  },
  {
    question: '产能可以定制吗？',
    answer: '可以。RXGF系列可根据瓶容量、配方和车间布局，从2,000BPH到24,000BPH进行配置。',
  },
  {
    question: '可以按完整生产线报价吗？',
    answer: '可以。方案可包含饮料调配、杀菌、冲洗、灌装、封盖、贴标、喷码、包装和输送连接。',
  },
  {
    question: '下单前需要确认哪些信息？',
    answer: '需要确认瓶容量、瓶型图纸、盖型、饮料配方、灌装温度、目标产能、电压、车间尺寸，以及是否需要单机或整线。',
  },
  {
    question: '页面参数是否就是最终报价参数？',
    answer: '页面参数用于果汁茶饮灌装线前期选型，最终型号、产能、重量和布局需根据瓶样及配方要求确认。',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description:
    '自动果汁茶饮生产线项目，适用于果汁、茶饮、风味饮料和其他非碳酸饮品，可配置调配、杀菌、冲洗、灌装、封盖、贴标和包装模块。',
  image: heroGallery.map((image) => new URL(image.src, 'https://spring-pack.cn').toString()),
  brand: {
    '@type': 'Brand',
    name: 'First Machinery',
  },
  manufacturer: {
    '@type': 'Organization',
    name: '中科美利（苏州）包装设备有限公司',
  },
  category: '果汁茶饮灌装机',
  sku: 'JUICE-生产-LINE-PROJECT',
  additionalProperty: keySpecs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};
---

<BaseLayout
  title={`${productName} | 果汁茶饮交钥匙方案`}
  description="果汁生产线项目适用于果汁、茶饮、风味饮料及其他不含气饮料，包含技术参数、产线模块和报价规划。"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="product-detail-page product-detail-page--rich product-detail-page--square-hero product-detail-page--compact-title solution-line-page">
    <section class="product-hero product-hero--rich">
      <div class="container product-rich-hero-inner">
        <div class="product-hero-breadcrumb-bar">
          <nav class="product-breadcrumb" aria-label="Breadcrumb">
            <a href="/">首页</a>
            <span>/</span>
            <a href="/solutions/">解决方案</a>
            <span>/</span>
            <a href="/products/filling-machine/juice-tea-filling-machine/">果汁茶饮灌装机</a>
          </nav>
        </div>

        <div class="product-hero-heading">
          <h1>{productName}</h1>
        </div>

        <div class="product-hero-content">
          <div class="product-hero-showcase">
            <div class="product-hero-gallery" data-product-gallery>
              <div class="product-hero-thumbs" role="tablist" aria-label="juice production line project images">
                {heroGallery.map((image, index) => (
                  <button
                    class:list={['product-hero-thumb', index === 0 && 'is-active']}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-label={`显示 ${image.label}`}
                    data-gallery-thumb
                    data-gallery-index={String(index)}
                    data-gallery-src={image.src}
                    data-gallery-alt={image.alt}
                  >
                    <img src={image.src} alt={`${image.alt} 缩略图`} width="120" height="120" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
                  </button>
                ))}
              </div>
              <div class="product-hero-frame">
                <button class="product-hero-gallery-btn product-hero-gallery-btn--prev" type="button" aria-label="上一张产品图片" data-gallery-prev>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15 18 9 12l6-6"></path>
                  </svg>
                </button>
                <div class="product-hero-media">
                  <img
                    src={heroGallery[0].src}
                    alt={heroGallery[0].alt}
                    width="960"
                    height="960"
                    loading="eager"
                    decoding="async"
                    data-gallery-main
                  />
                  <div class="product-hero-cert-badges" aria-label="Certification badges">
                    <span>CE</span>
                    <span>ISO</span>
                    <span>SGS</span>
                    <span>CNAS</span>
                  </div>
                </div>
                <button class="product-hero-gallery-btn product-hero-gallery-btn--next" type="button" aria-label="下一张产品图片" data-gallery-next>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="product-hero-form-card" id="quote">
            <div class="product-hero-intro-card">
              <p class="product-hero-intro-eyebrow">方案概述</p>
              <h2>{productName}</h2>
              <p>
                这条果汁生产线项目适用于果汁、茶饮、风味饮料和热灌装饮品生产。整线可配置调配、杀菌、冲洗灌装封盖、倒瓶杀菌、冷却、贴标、包装和输送系统。设备方案可根据饮料工艺、瓶型和目标产能灵活配置。
              </p>
              <a class="product-hero-phone-button" href="tel:18962223666" aria-label="拨打电话 18962223666">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
                </svg>
                电话咨询：18962223666
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-summary-strip">
      <div class="container product-summary-grid">
        <div>
          <p class="product-kicker">项目资料</p>
          <h2 class="section-title--secondary">企业实力与整线交付能力</h2>
        </div>
        <div class="product-summary-cards">
          <div><strong>20+</strong><span>年行业经验<small>丰富的设备制造与项目实施经验</small></span></div>
          <div><strong>整线</strong><span>交钥匙方案<small>从方案设计到安装调试一站式服务</small></span></div>
          <div><strong>CE / ISO</strong><span>国际认证<small>严格质量管理，符合国际标准</small></span></div>
          <div><strong>50+</strong><span>国家和地区<small>设备远销全球，提供完善售后支持</small></span></div>
        </div>
      </div>
    </section>

    <section class="product-section product-overview product-section--white" id="overview">
      <div class="container product-overview-layout">
        <div class="product-overview-head">
          <div>
            <h2 class="section-title--primary">整线方案</h2>
          </div>
        </div>
        <div class="product-line-flow-group">
          <figure class="product-layout-figure">
            <img
              src={`${assetBase}/juice-production-line-project-complete-line-layout.webp`}
              alt="完整 juice production line layout from processing to filling labeling and packing"
              width="1600"
              height="456"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="product-process-caption-strip" aria-label="果汁生产线流程">
            {processSteps.map(([title, text], index) => (
              <div class="product-process-item">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>


    <section class="juice-parameters-section" id="specifications">
      <div class="juice-parameters-container">
        <p class="juice-parameters-note">
          所有参数均可根据您的生产需求定制。
        </p>

        <h2 class="juice-parameters-title">
          技术 参数: 果汁热灌装线
        </h2>

        <div class="juice-parameters-scroll">
          <table class="juice-parameters-table">
            <thead>
              <tr>
                <th>型号</th>
                {juiceTechColumns.map((column) => <th>{column}</th>)}
              </tr>
            </thead>

            <tbody>
              {juiceTechRows.map((row) => (
                <tr>
                  <th scope="row">{row[0]}</th>
                  {row.length === 2 ? (
                    <td colspan={juiceTechColumns.length}>{row[1]}</td>
                  ) : (
                    row.slice(1).map((value) => <td>{value}</td>)
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="juice-parameters-footnote">
          技术参数可能会根据瓶型设计、生产条件和最终配置调整。
        </p>
      </div>
    </section>

    <section class="product-section product-feature-section">
      <div class="container">
        <div class="product-section-head">
          <p class="product-kicker">设备细节</p>
          <h2 class="section-title--secondary">客户重点查看的核心结构</h2>
        </div>
        <div class="product-machine-detail-layout">
          <div class="product-machine-detail-lead">
            <figure class="product-machine-detail-main product-machine-detail-main--wide-crop">
              <img
                src={machineDetailsOverview.image}
                alt={machineDetailsOverview.alt}
                width="800"
                height="534"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="product-machine-detail-summary">
              {machineAdvantages.map((item) => (
                <article>
                  <span class="product-machine-detail-icon" aria-hidden="true">
                    {item.icon === 'monoblock' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <rect x="7" y="12" width="34" height="24" rx="3"></rect>
                        <path d="M14 19h5m5 0h5m5 0h2M14 29h20"></path>
                        <path d="M16 36v5m16-5v5"></path>
                        <circle cx="19" cy="24" r="2.5"></circle>
                        <circle cx="29" cy="24" r="2.5"></circle>
                      </svg>
                    )}
                    {item.icon === 'output' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <path d="M8 32h6l4-11 6 17 5-14 4 8h7"></path>
                        <path d="M10 12h28v24H10z"></path>
                        <path d="M16 41h16"></path>
                      </svg>
                    )}
                    {item.icon === 'range' && (
                      <svg viewBox="0 0 48 48" role="img">
                        <path d="M13 18h22"></path>
                        <path d="M18 12 12 18l6 6"></path>
                        <path d="m30 12 6 6-6 6"></path>
                        <path d="M17 31c0-3 2-5 4-6v-4h6v4c2 1 4 3 4 6v7H17z"></path>
                        <path d="M20 38h8"></path>
                      </svg>
                    )}
                  </span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <div class="product-machine-detail-grid">
            {machineDetails.map((item) => (
              <article class="product-machine-detail-card">
                <img
                  src={item.image}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-line-module-section">
      <div class="container">
