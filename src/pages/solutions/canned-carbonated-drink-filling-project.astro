  },
  {
    question: '产能可以定制吗？',
    answer: '可以。可根据罐型、含气量和车间布局，从1,000BPH到15,000BPH进行配置。',
  },
  {
    question: '可以按完整生产线报价吗？',
    answer: '可以。方案可包含水处理、糖浆调配、二氧化碳比例控制、冲罐、等压灌装、封罐、喷码、包装和输送连接。',
  },
  {
    question: '下单前需要确认哪些信息？',
    answer: '需要确认罐容量、罐型图纸、盖型、含气量、灌装温度、目标产能、电压、车间尺寸，以及是否需要单机或整线。',
  },
  {
    question: '页面参数是否就是最终报价参数？',
    answer: '页面参数用于易拉罐碳酸饮料灌装项目前期选型，最终型号、产能、重量和布局需根据罐样及配方要求确认。',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description:
