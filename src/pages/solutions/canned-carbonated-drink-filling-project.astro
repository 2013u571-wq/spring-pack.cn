    width: 1200,
    height: 675,
  },
  {
    title: '等压灌装阀',
    text: '等压灌装阀用于保持二氧化碳含量，并提升灌装稳定性。',
    image: `${assetBase}/canned-carbonated-drink-filling-project-pressure-filling-valve-detail.webp`,
    alt: '碳酸饮料生产线等压灌装阀细节',
    width: 1200,
    height: 675,
  },
  {
    title: '自动封罐系统',
    text: '封罐段在灌装后立即完成封口，使成品罐质量保持稳定。',
    image: `${assetBase}/canned-carbonated-drink-filling-project-automatic-capping-system-detail.webp`,
    alt: '自动 seaming system reference for canned carbonated drink filling project',
    width: 1200,
    height: 675,
  },
];

const lineModules = [
  {
    title: '水处理系统',
    text: '前处理可配置原水箱、多介质过滤器、活性炭过滤器、RO系统、UV杀菌、臭氧杀菌和成品水箱。',
    image: `${assetBase}/canned-carbonated-drink-filling-project-water-treatment-system.webp`,
    alt: '碳酸饮料生产线用水处理系统',
  },
  {
    title: '饮料混合系统',
    text: '碳酸饮料混合系统支持糖浆调配、冷却和二氧化碳比例控制，适用于苏打水及气泡饮料生产。',
    image: `${assetBase}/canned-carbonated-drink-filling-project-carbonated-drink-mixing-system.webp`,
    alt: '碳酸饮料混合与二氧化碳比例混合系统',
  },
  {
    title: '易拉罐喷码与贴标',
    text: '可根据罐型设计和销售包装形式选择喷码、套标或外包装标识。',
    image: `${assetBase}/canned-carbonated-drink-filling-project-labeling-machine.webp`,
    alt: 'Coding and labeling support for canned carbonated drink filling project',
  },
  {
    title: '包装系统',
    text: '成品罐可连接膜包、纸箱包装、托盘包装和输送系统，便于后续发货。',
    image: `${assetBase}/canned-carbonated-drink-filling-project-packaging-system.webp`,
    alt: 'Packaging system for canned carbonated drink production line',
  },
];

const processSteps = [
  ['水处理', '根据原水水质配置过滤、RO、UV或臭氧处理工艺。'],
  ['糖浆调配', '根据汽水配方配置化糖、香精添加和糖浆调配。'],
  ['碳酸混合', '饮料在等压灌装前进行冷却并混入二氧化碳，以保持含气量。'],
  ['易拉罐冲洗', '空罐进入灌装段前会先进行冲洗或清洁。'],
  ['等压灌装', '等压灌装阀有助于减少泡沫并保持碳酸饮料的二氧化碳含量。'],
  ['封罐与包装', '灌装后立即完成封罐，然后连接喷码和包装设备。'],
];

const faqs = [
  {
    question: '这条易拉罐生产线可以灌装哪些产品？',
