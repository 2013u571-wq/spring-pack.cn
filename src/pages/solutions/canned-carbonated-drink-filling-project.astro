  image: heroGallery.map((image) => new URL(image.src, 'https://spring-pack.cn').toString()),
  brand: {
    '@type': 'Brand',
    name: 'First Machinery',
  },
  manufacturer: {
    '@type': 'Organization',
    name: '中科美利（苏州）包装设备有限公司',
