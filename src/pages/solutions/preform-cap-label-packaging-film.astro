---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const productName = '瓶坯/瓶盖/标签/包装膜';
const productUrl = 'https://spring-pack.cn/solutions/preform-cap-label-packaging-film/';
const materialBase = '/assets/first-machinery/solutions/preform-cap-label-packaging-film';
const gallery = [
  { src: `${materialBase}/bottle-caps-preforms-labels.webp`, alt: '瓶坯、瓶盖、标签和包装膜配套材料展示', label: '材料组合' },
  { src: `${materialBase}/beverage-bottle-caps.webp`, alt: '饮料瓶塑料瓶盖和封口盖', label: '瓶盖' },
  { src: `${materialBase}/pet-bottle-preforms.webp`, alt: '多规格PET瓶坯', label: 'PET瓶坯' },
  { src: `${materialBase}/colored-pet-bottle-preforms.webp`, alt: '多色PET瓶坯', label: '彩色瓶坯' },
  { src: `${materialBase}/custom-packaging-label-rolls.webp`, alt: '定制包装标签卷材', label: '定制标签' },
  { src: `${materialBase}/dispensing-and-bottle-caps.webp`, alt: '出液盖和饮料瓶盖', label: '出液盖' },
  { src: `${materialBase}/printed-packaging-label-rolls.webp`, alt: '印刷包装标签卷', label: '印刷标签' },
];
const specs = [
  ['产品范围', 'PET瓶坯、塑料瓶盖、定制标签、收缩套标、OPP标签和包装膜'],
  ['瓶型适配', '确认瓶口、螺纹、瓶容量、标签区域和成品包装形式'],
  ['应用范围', '瓶装水、果汁、茶饮、碳酸饮料、食用油及其他饮料或液体包装项目'],
  ['材料与颜色', '瓶坯克重、瓶盖材质、瓶盖颜色、标签材料和膜厚按项目选择'],
  ['定制内容', '瓶坯规格、盖型、Logo印刷、标签设计、卷材尺寸、纸箱包装和订单数量'],
  ['产线适配', '可与吹瓶机、理盖机、封盖机、贴标机和膜包设备配套确认'],
];
const categories = [
  ['PET瓶坯', '瓶坯克重、瓶口尺寸、颜色和瓶容量会根据吹瓶模具及灌装线需求匹配。'],
  ['饮料瓶盖', '螺纹盖、运动盖和出液盖会根据瓶口、垫片和封盖设备进行确认。'],
  ['定制标签', '可按瓶型设计和贴标机类型提供套标、OPP标签和不干胶标签。'],
  ['包装膜', '收缩膜和包装膜规格会根据包装形式、瓶数和膜包设备选择。'],
];
const faqs = [
  ['报价需要提供哪些信息？', '请提供瓶容量、瓶口规格、盖型、标签尺寸或设计稿、包装形式、膜材要求和目标数量。'],
  ['这些材料可以和整线设备一起确认吗？', '可以。瓶坯、瓶盖、标签和包装膜可与吹瓶、灌装、封盖、贴标和包装设备一起进行适配评估。'],
  ['可以提供哪些标签类型？', '可根据包装方案提供收缩套标、OPP热熔胶标签、不干胶标签和印刷标签卷材。'],
  ['瓶坯和瓶盖可以定制吗？', '可以。瓶坯克重、颜色、瓶口尺寸、瓶盖颜色、盖面Logo、垫片和包装方式都可在生产前确认。'],
];
const schema = { '@context': 'https://schema.org', '@type': 'Product', name: productName, description: '瓶坯、瓶盖、标签和包装膜等生产资料，可按饮料及液体包装项目配套定制。', image: gallery.map((item) => new URL(item.src, 'https://spring-pack.cn').toString()), brand: { '@type': 'Brand', name: 'First Machinery' }, category: '包装材料', url: productUrl };
---

<BaseLayout title={`${productName} | 中科美利（苏州）包装设备有限公司`} description="瓶坯、瓶盖、标签和包装膜等生产资料，可按饮料及液体包装项目配套定制。">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="pm-page" id="capacity">
    <section class="pm-product-hero"><div class="container pm-product-hero__head"><nav class="pm-top-breadcrumb" aria-label="Breadcrumb"><a href="/">首页</a><span>/</span><a href="/solutions/">解决方案</a><span>/</span><span>包装材料</span></nav><h1>{productName}</h1></div><div class="container pm-product-hero__grid"><div class="product-hero-showcase"><div class="product-hero-gallery" data-pm-gallery><div class="product-hero-thumbs" role="tablist" aria-label="瓶坯瓶盖标签包装膜图片">{gallery.map((item,index)=><button class:list={['product-hero-thumb',index===0&&'is-active']} type="button" role="tab" aria-selected={index===0?'true':'false'} data-pm-thumb data-src={item.src} data-alt={item.alt} aria-label={`显示 ${item.label}`}><img src={item.src} alt={`${item.alt} 缩略图`} width="120" height="120" loading="lazy" decoding="async" /></button>)}</div><div class="product-hero-frame"><button class="product-hero-gallery-btn product-hero-gallery-btn--prev" type="button" data-pm-prev aria-label="上一张产品图片"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6"></path></svg></button><div class="product-hero-media"><img src={gallery[0].src} alt={gallery[0].alt} width="960" height="960" loading="eager" decoding="async" data-pm-main style="object-position:center" /></div><button class="product-hero-gallery-btn product-hero-gallery-btn--next" type="button" data-pm-next aria-label="下一张产品图片"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div></div><div class="product-hero-form-card" id="quote">
  <div class="product-hero-intro-card">
    <p class="product-hero-intro-eyebrow">方案概述</p>
    <h2>{productName}</h2>
    <p>
      我们提供瓶坯、瓶盖、标签和包装膜等生产资料配套服务，可根据瓶型、瓶口、颜色、标签工艺、包装规格和订单数量定制。材料可与吹瓶、灌装、封盖、贴标和包装设备一起确认，帮助整线项目减少适配问题。
    </p>
    <a class="product-hero-phone-button" href="tel:18962223666" aria-label="拨打电话 18962223666">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
      </svg>
      电话咨询：18962223666
    </a>
  </div>
</div></div></section>
    <section class="pm-summary"><div class="container pm-summary__grid"><div><p class="pm-kicker">项目资料</p><h2>包装材料报价资料</h2></div><div class="pm-summary__cards"><div><strong>瓶坯</strong><span>瓶口尺寸、克重和瓶容量</span></div><div><strong>瓶盖</strong><span>螺纹、垫片、颜色和密封要求</span></div><div><strong>标签</strong><span>材料、设计稿和贴标机类型</span></div><div><strong>包装膜</strong><span>包装形式和膜包设备配置</span></div></div></div></section>
    <section class="pm-section"><div class="container"><p class="pm-kicker">技术规格</p><h2>包装材料 参数</h2><div class="pm-spec-table"><table><tbody>{specs.map(([name,value])=><tr><th scope="row">{name}</th><td>{value}</td></tr>)}</tbody></table></div></div></section>
    <section class="pm-section pm-section--soft"><div class="container"><div class="pm-section-head"><div><p class="pm-kicker">材料范围</p><h2>围绕瓶型和生产线定制配置</h2></div><p>每一种材料都会结合容器、灌装工艺和后段包装设备确认，减少实际生产中的适配问题。</p></div><div class="pm-detail-layout"><figure style="height:520px;align-self:start"><img src={`${materialBase}/cap-detail.avif`} alt="瓶cap closure and production material detail" width="1200" height="900" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover" /></figure><div class="pm-capability-list">{categories.map(([title,text],index)=><article><span>{String(index+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></div></section>
    <section class="pm-section pm-section--dark"><div class="container pm-solution"><div><p class="pm-kicker">匹配产线供货</p><h2>饮料项目用瓶坯、瓶盖、标签和包装膜</h2><ol><li>瓶坯根据瓶容量、瓶口、克重和吹瓶模具设计选择。</li><li>瓶盖根据螺纹、垫片、颜色、Logo和密封要求确认。</li><li>标签可匹配套标、OPP热熔胶或不干胶贴标机。</li><li>包装膜根据每包瓶数、热收缩温度和膜包形式选择。</li><li>正式生产前可确认材料样品和图纸。</li><li>材料供应可与灌装和包装整线一起做适配评估。</li></ol><a class="pm-primary-button" href="#inquiry">立即获取报价</a></div><figure style="min-height:0;align-self:start;background:transparent"><img src={`${materialBase}/plastic-bottle-caps.avif`} alt="饮料生产线用瓶坯瓶盖标签和包装膜" width="1200" height="900" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;object-fit:contain;background:transparent" /></figure></div></section>
    <section class="pm-section" id="inquiry"><div class="container pm-faq"><div><p class="pm-kicker">常见问题</p><h2>包装材料常见问题</h2></div><div>{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
  </article>
  <style>
    .pm-hero{position:relative;display:flex;align-items:center;min-height:500px;overflow:hidden;background:#07110c}.pm-hero__image,.pm-hero__shade{position:absolute;inset:0}.pm-hero__image{background:url('/assets/first-machinery/solutions/preform-cap-label-packaging-film/beverage-bottle-caps.webp') center 61%/cover no-repeat}.pm-hero__shade{background:linear-gradient(90deg,rgba(2,12,7,.92),rgba(2,12,7,.72) 42%,rgba(2,12,7,.18))}.pm-hero__inner{position:relative;width:min(1250px,100%);margin:auto;padding:88px 42px;color:#fff}.pm-breadcrumb{display:flex;gap:9px;margin-bottom:22px;color:#75cf8e;font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.pm-breadcrumb a{color:inherit;text-decoration:none}.pm-hero h1{max-width:820px;margin:0 0 23px;font-size:clamp(38px,5vw,62px);line-height:1.08;letter-spacing:-.04em}.pm-hero p{max-width:640px;margin:0 0 34px;color:rgba(255,255,255,.75);font-size:17px;line-height:1.55}.pm-primary-button{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 26px;border:1px solid #176b36;border-radius:5px;background:#176b36;color:#fff!important;font-size:14px;font-weight:800;text-decoration:none}.pm-page{width:100%;min-width:0;overflow:hidden;color:#18201b}.pm-product-hero{padding:58px 0}.pm-product-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,460px);gap:24px;align-items:start}.pm-gallery,.product-hero-form-card{min-width:0}.pm-gallery__main{position:relative;overflow:hidden;background:#edf0ed;aspect-ratio:4/3}.pm-gallery__main>img{width:100%;height:100%;object-fit:cover}.pm-gallery__main>button{position:absolute;top:50%;display:grid;width:43px;height:43px;place-items:center;border:0;background:rgba(16,37,23,.85);color:#fff;font-size:24px;cursor:pointer;transform:translateY(-50%)}.pm-gallery__main [data-pm-prev]{left:14px}.pm-gallery__main [data-pm-next]{right:14px}.pm-gallery__thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;overflow-y:hidden}.pm-gallery__thumb{flex:0 0 88px;padding:0;border:2px solid transparent;background:#edf0ed;cursor:pointer}.pm-gallery__thumb.is-active{border-color:#176b36}.pm-gallery__thumb img{display:block;width:100%;height:68px;object-fit:cover}.pm-kicker{margin:0 0 11px;color:#35623e;font:800 12px/1.2 "IBM Plex Mono",monospace;letter-spacing:.14em;text-transform:uppercase}.pm-section h2{margin:0 0 17px;font-size:clamp(27px,3.2vw,40px);line-height:1.12;letter-spacing:-.03em}.pm-section p{color:#606a63;font-size:16px;line-height:1.65}.pm-summary{padding:45px 0;background:#15241a;color:#fff}.pm-summary__grid{display:grid;grid-template-columns:.8fr 1.5fr;gap:40px;align-items:center}.pm-summary h2{margin:0;font-size:28px;line-height:1.18}.pm-summary .pm-kicker,.pm-section--dark .pm-kicker{color:#8ad3a0}.pm-summary__cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.14)}.pm-summary__cards>div{min-height:100px;padding:18px;background:#15241a}.pm-summary__cards strong,.pm-summary__cards span{display:block}.pm-summary__cards strong{margin-bottom:8px;color:#8ad3a0;font-size:20px}.pm-summary__cards span{color:rgba(255,255,255,.68);font-size:12px;line-height:1.4}.pm-section{padding:80px 0}.pm-section--soft{background:#f3f5f3}.pm-section--dark{background:#0c1710;color:#fff}.pm-section--dark p{color:rgba(255,255,255,.72)}.pm-spec-table{overflow:auto;margin-top:28px;border:1px solid #dde5dd}.pm-spec-table table{width:100%;border-collapse:collapse;font-size:15px}.pm-spec-table th,.pm-spec-table td{padding:17px 20px;border-bottom:1px solid #dde5dd;text-align:left;vertical-align:top}.pm-spec-table th{width:31%;background:#f5f8f5;color:#203226}.pm-spec-table tr:last-child>*{border-bottom:0}.pm-section-head{display:flex;justify-content:space-between;gap:50px;align-items:end;margin-bottom:34px}.pm-section-head>div{max-width:600px}.pm-section-head>p{max-width:430px;margin:0}.pm-detail-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:38px;align-items:stretch}.pm-detail-layout figure,.pm-solution figure{margin:0;background:#dfe6df}.pm-detail-layout figure img,.pm-solution figure img{display:block;width:100%;height:100%;object-fit:cover}.pm-capability-list{display:grid;gap:1px;background:#dce4dc}.pm-capability-list article{display:flex;gap:20px;padding:24px;background:#fff}.pm-capability-list span{color:#35623e;font:800 13px/1 "IBM Plex Mono",monospace}.pm-capability-list h3{margin:0 0 7px;font-size:18px}.pm-capability-list p{margin:0;font-size:14px!important}.pm-solution{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}.pm-solution h2{font-size:clamp(30px,4vw,48px)}.pm-solution ol{display:grid;gap:10px;margin:0 0 24px;padding-left:22px;color:rgba(255,255,255,.78);font-size:16px;line-height:1.55}.pm-solution .pm-primary-button{margin-top:0}.pm-solution figure{min-height:390px}.pm-faq{display:grid;grid-template-columns:.85fr 1.15fr;gap:55px}.pm-faq details{border-top:1px solid #dce4dc}.pm-faq details:last-child{border-bottom:1px solid #dce4dc}.pm-faq summary{padding:20px 34px 20px 0;cursor:pointer;font-size:17px;font-weight:800;list-style:none}.pm-faq summary:after{content:'+';float:right;color:#35623e;font-size:25px;font-weight:400}.pm-faq details[open] summary:after{content:'−'}.pm-faq details p{margin:0;padding:0 28px 22px 0;font-size:14px}@media(max-width:900px){.pm-product-hero__grid,.pm-detail-layout,.pm-solution,.pm-faq,.pm-summary__grid{grid-template-columns:1fr}.pm-summary__cards{grid-template-columns:repeat(2,1fr)}.pm-section-head{display:block}.pm-section-head>p{margin-top:15px}}@media(max-width:600px){.pm-page,.pm-product-hero,.pm-summary,.pm-section{width:100%;max-width:none}.pm-hero{min-height:390px;align-items:end}.pm-hero__inner{padding:40px 20px}.pm-hero h1{font-size:34px}.pm-hero p{font-size:14px;margin-bottom:23px}.pm-product-hero,.pm-section{padding:44px 0}.product-hero-form{padding:22px 18px}.product-hero-form label,.product-hero-form label.product-hero-form-message{grid-template-columns:1fr;gap:7px;min-height:0}.product-hero-form em.is-visible{grid-column:auto}.product-hero-form-message>span{padding-top:0}.product-hero-phone-control{grid-template-columns:minmax(96px,.36fr) minmax(0,1fr)}.product-hero-form-message textarea{min-height:120px}.pm-summary{padding:40px 0}.pm-summary__cards>div{min-height:86px;padding:14px}.pm-gallery__thumb{flex-basis:74px}.pm-gallery__thumb img{height:58px}}
    .pm-product-hero {
      padding: 28px 0 58px;
      background: #f7f8f5;
    }

    .pm-product-hero__head {
      margin-bottom: 30px;
    }

    .pm-top-breadcrumb {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 26px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(16, 24, 21, 0.12);
      color: #5f6861;
      font-size: 14px;
      font-weight: 800;
    }

    .pm-top-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .pm-top-breadcrumb span:last-child {
      color: #303a33;
    }

    .pm-product-hero__head h1 {
      margin: 0;
      color: #101815;
      font-family: "Space Grotesk", Manrope, sans-serif;
      font-size: 40px;
      font-weight: 500;
      line-height: 1.08;
      text-align: center;
    }

    .pm-product-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(420px, 460px);
      align-items: stretch;
    }

    .pm-product-hero .product-hero-showcase {
      width: 100%;
      max-width: 100%;
      justify-self: stretch;
      overflow: hidden;
    }

    .pm-product-hero .product-hero-gallery {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-columns: 1fr;
      gap: 14px;
      align-items: stretch;
      width: 100%;
      height: 100%;
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
    }

    .pm-product-hero .product-hero-frame,
    .pm-product-hero .product-hero-media,
    .pm-product-hero .product-hero-media > img {
      aspect-ratio: 1 / 1 !important;
    }

    .pm-product-hero .product-hero-media {
      padding: clamp(12px, 2vw, 22px);
      background: #fff;
      border: 1px solid rgba(57, 93, 61, 0.14);
      box-shadow: 0 24px 90px rgba(7, 16, 27, 0.1);
      overflow: hidden;
    }

    .pm-product-hero .product-hero-media > img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain !important;
      object-position: center !important;
      transform: none !important;
      background: #f8faf6;
    }

    .pm-gallery {
      border: 1px solid rgba(16, 24, 21, 0.08);
      background: #f1f2ef;
      box-shadow: 0 24px 80px rgba(16, 24, 21, 0.08);
    }

    .pm-gallery__main {
      background: #f3f4f1;
      aspect-ratio: 4 / 3;
      max-height: 720px;
    }

    .pm-gallery__main > img {
      object-fit: contain;
      padding: 18px;
      background: #f3f4f1;
    }

    .pm-gallery__main > button {
      width: 46px;
      height: 46px;
      border-radius: 999px;
      background: #fff;
      color: #101815;
      box-shadow: 0 14px 35px rgba(16, 24, 21, 0.18);
    }

    .pm-gallery__thumbs {
      padding: 10px;
      margin-top: 0;
      background: #fff;
    }

    .pm-gallery__thumb {
      flex-basis: 86px;
      border-color: rgba(16, 24, 21, 0.12);
    }

    @media (max-width: 900px) {
      .pm-product-hero__head h1 {
        font-size: 34px;
      }

      .pm-product-hero__grid {
        grid-template-columns: 1fr;
      }

      .pm-product-hero .product-hero-gallery,
      .pm-product-hero .product-hero-form-card {
        width: 100%;
        max-width: 820px;
      }
    }

    @media (max-width: 600px) {
      .pm-product-hero {
        padding-top: 20px;
      }

      .pm-top-breadcrumb {
        margin-bottom: 20px;
        font-size: 13px;
      }

      .pm-product-hero__head h1 {
        font-size: 30px;
      }

      .pm-gallery__main > img {
        padding: 10px;
      }

      .pm-gallery__main {
        aspect-ratio: 1 / 1;
      }
    }

    /* Material imagery: crop product graphics without showing their embedded logo strips. */
    .pm-gallery__main > img { object-position: center 70%; }

    /* Keep the category image compact instead of stretching it to the height of the four text rows. */
    .pm-detail-layout { align-items: start; }
    .pm-detail-layout figure { height: 520px; }
    .pm-detail-layout figure img { height: 100%; object-fit: cover; }

    /* Preserve the supplied cap photo's natural proportions, without a colored area below it. */
    .pm-solution figure { min-height: 0; align-self: start; background: transparent; }
    .pm-solution figure img { height: auto; object-fit: contain; background: transparent; }

    @media (max-width: 600px) {
      .pm-detail-layout figure { height: 320px; }
    }
  </style>
  <script is:inline>document.querySelectorAll('[data-pm-gallery]').forEach((gallery)=>{const main=gallery.querySelector('[data-pm-main]');const thumbs=Array.from(gallery.querySelectorAll('[data-pm-thumb]'));let current=0;const show=(index)=>{current=(index+thumbs.length)%thumbs.length;const button=thumbs[current];main.src=button.dataset.src;main.alt=button.dataset.alt;main.style.objectPosition='center 70%';thumbs.forEach((item,itemIndex)=>item.classList.toggle('is-active',itemIndex===current));};thumbs.forEach((button,index)=>button.addEventListener('click',()=>show(index)));gallery.querySelector('[data-pm-prev]')?.addEventListener('click',()=>show(current-1));gallery.querySelector('[data-pm-next]')?.addEventListener('click',()=>show(current+1));});</script>
</BaseLayout>
