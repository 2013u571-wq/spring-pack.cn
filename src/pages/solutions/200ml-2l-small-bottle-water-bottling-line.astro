              <tr>
                <th>清洗介质</th>
                <td colspan="6">无菌水</td>
              </tr>

              <tr>
                <th>冲洗压力</th>
                <td colspan="6">0.06–0.2 MPa</td>
              </tr>

              <tr>
                <th>应用</th>
                <td colspan="6">瓶装水生产线</td>
              </tr>

              <tr>
                <th>总功率</th>
                <td>4.4 kW</td>
                <td>4.4 kW</td>
                <td>4.4 kW</td>
