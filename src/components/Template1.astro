---
interface Props {
  title?: string;
  description?: string;
  whatsappLabel?: string;
  whatsappHref?: string;
  email?: string;
  emailHref?: string;
}

const {
  title = '需要立即咨询？',
  description = '欢迎直接联系我们，获取更快的沟通和项目支持。',
  whatsappLabel = '18962223666',
  whatsappHref = 'tel:18962223666',
  email = 'manager@spring-pack.com',
  emailHref = 'mailto:manager@spring-pack.com',
} = Astro.props;
---

<section class="thanks-assistance template-1" aria-labelledby="template-1-title">
  <div class="thanks-assistance-bg" aria-hidden="true"></div>
  <div class="thanks-assistance-inner">
    <div class="thanks-assistance-head">
      <div class="thanks-assistance-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path d="M11 28v-4a13 13 0 0 1 26 0v4" /><path d="M10 28h6v11h-6zM32 28h6v11h-6zM32 39c-2 4-5 5-10 5h-3" /></svg>
      </div>
      <div>
        <h2 id="template-1-title">{title}</h2>
        <p>{description}</p>
      </div>
    </div>

    <div class="thanks-assistance-links">
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M39 23.5a15 15 0 0 1-22 13.2L9 39l2.3-7.7A15 15 0 1 1 39 23.5Z" /><path d="M19 16.5c.4-.7.8-.8 1.3-.8h1.1c.4 0 .7.2.9.7l1.1 2.8c.2.5.1.9-.2 1.2l-.8.9c1.4 2.4 3.2 4.1 5.6 5.3l.9-1c.4-.3.8-.4 1.2-.2l2.8 1.3c.5.2.7.5.7 1v1c0 .6-.3 1-.8 1.3-.9.5-2 .8-3.2.5-6.7-1.4-10.9-5.5-12.2-12.1-.2-.7.2-1.4.4-1.9Z" /></svg>
        <span>电话咨询</span>
        <strong>{whatsappLabel}</strong>
      </a>
      <a href={emailHref}>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 14h32v22H8z" /><path d="m8 16 16 12 16-12" /></svg>
        <span>邮箱</span>
        <strong>{email}</strong>
      </a>
    </div>
  </div>
</section>

<style>
  .thanks-assistance {
    position: relative;
    overflow: hidden;
    padding: 54px 24px;
    background: #06131d;
    color: #fff;
  }

  .thanks-assistance-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 19, 29, 0.94), rgba(6, 19, 29, 0.76)),
      url("/assets/first-machinery/company/factory-strength-line-testing.webp") right center / cover;
    opacity: 0.9;
  }

  .thanks-assistance-inner {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(1180px, 100%);
    margin: 0 auto;
    grid-template-columns: minmax(0, 1.05fr) minmax(520px, 0.95fr);
    gap: 42px;
    align-items: center;
  }

  .thanks-assistance-head {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }

  .thanks-assistance-icon {
    display: grid;
    width: 76px;
    height: 76px;
    place-items: center;
    border-radius: 999px;
    background: radial-gradient(circle at 34% 22%, #2aa565, #063);
    color: #fff;
    box-shadow: 0 16px 38px rgba(0, 102, 51, 0.34);
  }

  .thanks-assistance svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thanks-assistance-icon svg {
    width: 42px;
    height: 42px;
  }

  .thanks-assistance h2 {
    margin: 0 0 10px;
    color: #fff;
    font-size: clamp(26px, 3vw, 32px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .thanks-assistance p {
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 15px;
    line-height: 1.6;
  }

  .thanks-assistance-links {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: end;
    gap: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }

  .thanks-assistance-links a {
    display: grid;
    grid-template-columns: 42px max-content;
    gap: 8px 16px;
    align-items: center;
    min-width: 0;
    padding: 10px 28px;
    color: #fff;
    text-decoration: none;
    border-right: 1px solid rgba(255, 255, 255, 0.18);
  }

  .thanks-assistance-links a:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .thanks-assistance-links svg {
    grid-row: span 2;
    width: 38px;
    height: 38px;
    color: #79d765;
  }

  .thanks-assistance-links span {
    color: rgba(255, 255, 255, 0.88);
    font-size: 13px;
    font-weight: 800;
  }

  .thanks-assistance-links strong {
    color: rgba(255, 255, 255, 0.86);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: normal;
    white-space: nowrap;
  }

  .thanks-assistance a:focus-visible {
    outline: 3px solid rgba(103, 197, 135, 0.48);
    outline-offset: 4px;
  }

  @media (max-width: 1199px) {
    .thanks-assistance-inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .thanks-assistance-links {
      justify-content: start;
      border-left: 0;
    }

    .thanks-assistance-links a:first-child {
      padding-left: 0;
    }
  }

  @media (max-width: 767px) {
    .thanks-assistance {
      padding: 42px 20px;
    }

    .thanks-assistance-inner {
      gap: 30px;
    }

    .thanks-assistance-head {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 18px;
    }

    .thanks-assistance-icon {
      width: 64px;
      height: 64px;
    }

    .thanks-assistance-icon svg {
      width: 35px;
      height: 35px;
    }

    .thanks-assistance-links {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .thanks-assistance-links a,
    .thanks-assistance-links a:first-child,
    .thanks-assistance-links a:last-child {
      padding: 0;
      border-right: 0;
    }
  }
</style>
