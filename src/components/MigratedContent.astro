const labelingMachine选项 = `
<section class="labeling-options" id="capacity">
  <div class="labeling-options__head"><span>贴标机解决方案</span><h2>贴标机选项</h2><p>运行可靠、贴标准确，适用于现代化生产线。</p></div>
  <div class="labeling-options__list">
    <article class="labeling-options__card"><div class="labeling-options__image" data-image-carousel><img src="/assets/first-machinery/products/labeling-machine/hot-melt/hot-melt-labeling-machine.webp" alt="热熔胶贴标机" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/hot-melt/hot-melt-labeling-machine-detail-1.webp" alt="热熔胶贴标机送标机构细节" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/hot-melt/hot-melt-labeling-machine-detail-2.webp" alt="热熔胶贴标机滚标机构细节" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/hot-melt/hot-melt-labeling-machine-detail-3.webp" alt="热熔胶贴标机生产线实拍" loading="lazy"><div class="labeling-options__arrows"><button type="button" data-carousel-prev aria-label="上一张图片">←</button><button type="button" data-carousel-next aria-label="下一张图片">→</button></div></div><div class="labeling-options__content"><b>01</b><h3>热熔胶贴标机</h3><p>热熔胶贴标机适用于瓶体和容器的纸标、膜标高速贴标，可自动完成进瓶、涂胶、贴标和出瓶。设备运行稳定、粘贴牢固、贴标效果整洁，适用于食品、饮料、日化和医药行业的圆形、方形及规则容器。</p><a href="/contact/">立即获取报价 <span>→</span></a></div></article>
    <article class="labeling-options__card labeling-options__card--reverse"><div class="labeling-options__image" data-image-carousel><img src="/assets/first-machinery/products/labeling-machine/shrink-sleeve/labeling-cover.webp" alt="全自动套标机" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/shrink-sleeve/shrink-sleeve-labeling-machine-detail-1.webp" alt="全自动套标机设备细节" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/shrink-sleeve/shrink-sleeve-labeling-machine-detail-2.webp" alt="套标机标签输送机构" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/shrink-sleeve/shrink-sleeve-labeling-machine-detail-3.webp" alt="套标机生产线应用" loading="lazy"><div class="labeling-options__arrows"><button type="button" data-carousel-prev aria-label="上一张图片">←</button><button type="button" data-carousel-next aria-label="下一张图片">→</button></div></div><div class="labeling-options__content"><b>02</b><h3>全自动套标机</h3><p>全自动套标机集进瓶、切标、套标、热收缩和出瓶于一体，采用光电定位和 PLC 控制，套标位置准确、收缩平整，不易起皱或产生气泡，适用于圆瓶、方瓶、扁瓶、罐和广口瓶等包装。</p><a href="/contact/">立即获取报价 <span>→</span></a></div></article>
    <article class="labeling-options__card"><div class="labeling-options__image" data-image-carousel><img src="/assets/first-machinery/products/labeling-machine/self-adhesive/self-adhesive-labeling-machine.webp" alt="不干胶贴标机" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/self-adhesive/self-adhesive-labeling-machine-detail-1.webp" alt="不干胶贴标机输送机构" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/self-adhesive/self-adhesive-labeling-machine-detail-2.webp" alt="不干胶贴标机操作细节" loading="lazy"><img src="/assets/first-machinery/products/labeling-machine/self-adhesive/self-adhesive-labeling-machine-detail-3.webp" alt="不干胶贴标机生产应用" loading="lazy"><div class="labeling-options__arrows"><button type="button" data-carousel-prev aria-label="上一张图片">←</button><button type="button" data-carousel-next aria-label="下一张图片">→</button></div></div><div class="labeling-options__content"><b>03</b><h3>不干胶贴标机</h3><p>自动不干胶贴标机适用于圆形、扁形、方形容器的连续精密贴标，可自动送标、定位、贴标和压标，贴标精度高、运行稳定。可调结构适配多种产品尺寸，适用于正背标、环绕标、顶标和底标等应用。</p><a href="/contact/">立即获取报价 <span>→</span></a></div></article>
  </div>
