---
import { countryDialOptions, defaultCountryName } from '@/data/countryDialOptions';

interface Props {
  item: {
    title: string;
    content: string;
    textLength: number;
    slug?: string;
  };
}

const { item } = Astro.props;
const countryOptions = countryDialOptions
  .map(
    (country) =>
      `<option value="${country.country}" data-dial="${country.code}"${country.country === defaultCountryName ? ' selected' : ''}>${country.flag} ${country.code}</option>`,
  )
  .join('');

const commonProductForm = `
