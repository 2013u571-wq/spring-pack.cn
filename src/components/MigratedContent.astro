<style>
  .labeling-options{padding:clamp(50px,7vw,90px) 0;background:#fff;overflow:hidden}.labeling-options__head{max-width:760px;margin:0 auto 38px;padding:0 max(20px,5vw);text-align:center}.labeling-options__head>span{color:#456348;font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.labeling-options__head h2{margin:12px 0 10px;color:#171b18;font-size:clamp(30px,4vw,48px);line-height:1.1}.labeling-options__head p{margin:0;color:#616a64;font-size:16px}.labeling-options__list{display:grid;width:100%;margin:auto}.labeling-options__card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:470px;background:#fff}.labeling-options__card:nth-child(even){background:#f2f5f7}.labeling-options__card--reverse .labeling-options__image{order:2}.labeling-options__image{position:relative;min-height:470px;overflow:hidden;background:#eff1f0}.labeling-options__image img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .3s ease}.labeling-options__image:not(.carousel-ready) img:first-child,.labeling-options__image img.is-active{opacity:1}.labeling-options__arrows{position:absolute;right:20px;bottom:20px;z-index:2;display:flex;gap:8px}.labeling-options__arrows button{display:grid;width:42px;height:42px;place-items:center;border:1px solid #fff;background:rgba(31,59,39,.88);color:#fff;font-size:21px;line-height:1;cursor:pointer;transition:background .2s}.labeling-options__arrows button:hover{background:#456348}.labeling-options__content{box-sizing:border-box;display:grid;width:min(750px,100%);align-content:center;justify-items:start;gap:16px;padding:clamp(36px,5vw,82px)}.labeling-options__card--reverse .labeling-options__content{justify-self:end}.labeling-options__content>b{display:grid;width:32px;height:32px;place-items:center;border-radius:5px;background:#456348;color:#fff;font:800 12px/1 "IBM Plex Mono",monospace}.labeling-options__content h3{margin:0;color:#171b18;font-size:clamp(23px,2.