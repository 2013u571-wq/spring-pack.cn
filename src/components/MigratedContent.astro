      /(<section class="wt-hero">[\s\S]*?<\/section>)/,
      `$1<style>
        .elementor-166 .wt-hero { min-height: 500px !important; }
        @media (max-width: 767px) {
          .elementor-166 .wt-hero { min-height: 340px !important; }
        }
      </style>`,
    );
}

const renderedContent = item.slug === 'projects' ? `${projectsHeroSection}${homeProjectCasesSection}` : content;
const hasContent = item.textLength > 0 || item.slug === 'projects';
---

{hasContent ? (
  <article class="migrated-content" set:html={renderedContent} />
) : (
  <section class="empty-page">
    <div class="container">
      <div class="empty-page-panel">
        <span>Current WordPress content</span>
        <h1>{item.title}</h1>
        <p>本项目 public WordPress page currently exposes no body content through the REST API. The route is preserved locally so future content can be added without changing navigation.</p>
        <a class="green-btn" href={`/contact/?source=empty-page&sourceTitle=${encodeURIComponent(item.title)}`}>获取资料</a>
      </div>
    </div>
  </section>
)}

<script is:inline>
  document.querySelectorAll('[data-image-carousel]').forEach((carousel) => {
    const images = Array.from(carousel.querySelectorAll('img'));
    if (images.length < 2) return;

    let current = 0;
    const showImage = (index) => {
      current = (index + images.length) % images.length;
      images.forEach((image, imageIndex) => image.classList.toggle('is-active', imageIndex === current));
    };

    carousel.classList.add('carousel-ready');
    showImage(0);
    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => showImage(current - 1));
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => showImage(current + 1));
  });

  document.querySelectorAll('[data-home-delivery]').forEach((section) => {
    const stages = Array.from(section.querySelectorAll('[data-home-stage]'));
    const title = section.querySelector('[data-home-delivery-title]');
    const list = section.querySelector('[data-home-delivery-items]');
    const index = section.querySelector('[data-home-delivery-index]');
    const spotlight = section.querySelector('.home-project-delivery__spotlight');
    const line = section.querySelector('.home-project-delivery__line');

    const selectStage = (stage, stageIndex) => {
      stages.forEach((button) => {
        const active = button === stage;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });

      if (title) title.textContent = stage.dataset.title || '';
      if (index) index.textContent = `${String(stageIndex + 1).padStart(2, '0')} / ${String(stages.length).padStart(2, '0')}`;
      if (list) {
        list.innerHTML = (stage.dataset.items || '')
          .split('|')
          .filter(Boolean)
          .map((item) => `<li>${item}</li>`)
          .join('');
      }
      if (spotlight instanceof HTMLElement) {
        spotlight.style.left = stage.dataset.spotLeft || '';
        spotlight.style.top = stage.dataset.spotTop || '';
      }
      if (line instanceof HTMLElement) {
        line.style.left = stage.dataset.lineLeft || '';
        line.style.top = stage.dataset.lineTop || '';
      }
    };

    stages.forEach((stage, stageIndex) => {
      stage.addEventListener('mouseenter', () => selectStage(stage, stageIndex));
      stage.addEventListener('focus', () => selectStage(stage, stageIndex));
      stage.addEventListener('click', () => selectStage(stage, stageIndex));
    });
  });
</script>
